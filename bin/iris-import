#!/bin/bash
# Import every new run in the run index into your tracking store,
# /srv/scratch/$USER/iris/tracking.db (lib/iris/tracking.py). Run it in a
# Virtual Desktop or a job, not on a login node. bin/iris-compare runs it
# before it opens MLflow.
#
# A shim over bin/iris-python, which runs it in the imaging environment
# lib/katana.sh pins, or another with ENV_DIR=...
exec "$(dirname "$(readlink -f "$0")")/iris-python" iris.tracking "$@"

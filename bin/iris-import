#!/bin/bash
# Import every new run in the run index into your tracking store,
# /srv/scratch/$USER/iris/tracking.db (lib/iris/tracking.py). Run it in a
# Virtual Desktop or a job, not on a login node. iris-compare (#37) is to run
# it before it opens MLflow.
#
# Runs with the imaging environment the form pins (keep the two in step),
# or another with ENV_DIR=...
# Keep it free of `set -u`: the module scripts reference unset variables.

set -eo pipefail
ENV_DIR="${ENV_DIR:-/srv/scratch/katana_ai/iris/envs/imaging/1}"
LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"

if [ -f /etc/profile.d/modules.sh ]; then
    . /etc/profile.d/modules.sh
    module load python/3.13.2
fi
PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}" exec "$ENV_DIR/bin/python" -m iris.tracking

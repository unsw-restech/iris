#!/bin/bash
# Run the tests that only run on Katana, every form test, the module test
# and the library's job-library test, on this clone's tracked files,
# uncommitted edits included. No push needed: run it from any clone or
# worktree before committing. The tree goes to a folder of its own in
# /srv/scratch/$USER, deleted when the run ends, so no clone on Katana is
# touched and nothing is left behind.
#
# The job-library test needs Katana's modules, so it runs as a small PBS
# job (lib/tests/katana/job_lib.pbs, sized in its header) that qsub -W block
# waits for, queue time included, keeping the login node light. PBS copies
# its log into place a little after that, so the run waits up to 2 minutes
# for the log's last line and fails if it never comes. It tests the shared
# library, so it is submitted once, however many workflows.
#
#   bin/katana-test
#
# Exits 0 only if every test passed. Files git doesn't track stay behind,
# so it names any under workflows/, module/ or lib/: `git add` a new test
# first. The module test needs katana_ai_ro membership. `git archive` keeps
# module/bin's links, which a desktop clone with core.symlinks off checks
# out as plain files. Over `ssh katana`.

set -o pipefail
[ $# -eq 0 ] || { echo "usage: bin/katana-test" >&2; exit 2; }
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
# A commit holding the working tree's tracked files; empty when it's clean.
tree="$(git stash create)" || { echo "katana-test: git stash create failed; finish the merge or rebase first" >&2; exit 1; }
untracked="$(git ls-files --others --exclude-standard workflows module lib)"
[ -z "$untracked" ] || printf 'Not sent, since git does not track them:\n%s\n' "$untracked"
echo "Testing ${tree:+uncommitted edits on }$(git log -1 --format='%h %s') on Katana"

# ruby/3.2.0: Katana's Ruby module (../available-modules.md).
# shellcheck disable=SC2016  # expanded on Katana
git archive --format=tar "${tree:-HEAD}" | ssh katana '
    d=$(mktemp -d "/srv/scratch/$USER/katana-test.XXXXXX") || exit 1
    trap '\''chmod -R u+rwx "$d"; rm -rf "$d"'\'' EXIT
    mkdir "$d/iris" && cd "$d/iris" && tar xf - || exit 1
    # The job library records the clone'\''s commit, so the tree is a repo.
    git init -q && git add -A && git -c user.name=katana-test -c user.email=- commit -q --no-verify -m tree || exit 1
    . /etc/profile.d/modules.sh && module load ruby/3.2.0 || exit 1
    s=0
    for t in workflows/*/tests/test_form.rb; do
        echo "== $t"; ruby "$t" || s=1
    done
    echo "== module/tests/test_module.sh"; bash module/tests/test_module.sh || s=1
    echo "== lib/tests/katana/job_lib.pbs"
    log="$d/job_lib.log" log_wait=120
    qsub -W block=true -m abe -j oe -o "$log" \
        -v "T=$d,PYTHONUNBUFFERED=1" lib/tests/katana/job_lib.pbs || s=1
    # PBS copies the log into place after the blocking submit returns, so
    # wait for the job'\''s last line, "exit <status>", before showing it.
    while ! grep -q "^exit [0-9]" "$log" 2> /dev/null && [ $((log_wait--)) -gt 0 ]; do sleep 1; done
    cat "$log" 2> /dev/null
    grep -q "^exit [0-9]" "$log" 2> /dev/null ||
        { echo "katana-test: $log has no last line, exit <status>, so the job-library test output is missing" >&2; s=1; }
    exit $s'

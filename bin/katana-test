#!/bin/bash
# Run the tests that only run on Katana, every form test and the module
# test, on this clone's tracked files, uncommitted edits included. The tree
# goes to a folder of its own in /srv/scratch/$USER, deleted when the run
# ends, so no clone on Katana is touched and nothing is left behind.
#
#   bin/katana-test
#
# Exits 0 only if every test passed. Files git doesn't track stay behind,
# so it names any under workflows/ or module/: `git add` a new test first.
# The module test needs katana_ai_ro membership. `git archive` keeps
# module/bin's links, which a desktop clone with core.symlinks off checks
# out as plain files. Over `ssh katana`.

set -o pipefail
[ $# -eq 0 ] || { echo "usage: bin/katana-test" >&2; exit 2; }
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
# A commit holding the working tree's tracked files; empty when it's clean.
tree="$(git stash create)" || { echo "katana-test: git stash create failed; finish the merge or rebase first" >&2; exit 1; }
untracked="$(git ls-files --others --exclude-standard workflows module)"
[ -z "$untracked" ] || printf 'Not sent, since git does not track them:\n%s\n' "$untracked"
echo "Testing ${tree:+uncommitted edits on }$(git log -1 --format='%h %s') on Katana"

# ruby/3.2.0: Katana's Ruby module (../available-modules.md).
# shellcheck disable=SC2016  # expanded on Katana
git archive --format=tar "${tree:-HEAD}" | ssh katana '
    d=$(mktemp -d "/srv/scratch/$USER/katana-test.XXXXXX") || exit 1
    trap '\''chmod -R u+rwx "$d"; rm -rf "$d"'\'' EXIT
    cd "$d" && tar xf - || exit 1
    . /etc/profile.d/modules.sh && module load ruby/3.2.0 || exit 1
    s=0
    for t in workflows/*/tests/test_form.rb; do
        echo "== $t"; ruby "$t" || s=1
    done
    echo "== module/tests/test_module.sh"; bash module/tests/test_module.sh || s=1
    exit $s'

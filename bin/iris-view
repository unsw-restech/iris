#!/bin/bash
# View a run's label volume over its raw volume in napari
# (lib/iris/view.py): bin/iris-view <dataset>/runs/<job ID>, or with no
# argument pick from your recent runs. Run it in a terminal in a Virtual
# Desktop; closing the napari window ends it.
#
# Runs with the imaging environment the form pins (bin/check keeps them
# the same), or another with ENV_DIR=... Keep it free of `set -u`: the
# module scripts reference unset variables.

set -eo pipefail
ENV_DIR="${ENV_DIR:-/srv/scratch/katana_ai/iris/envs/imaging/1}"
LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"

if [ -f /etc/profile.d/modules.sh ]; then
    . /etc/profile.d/modules.sh
    module load python/3.13.2
fi
PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}" exec "$ENV_DIR/bin/python" -m iris.view "$@"

#!/bin/bash
# Show what pulling main into the system clone would deploy to the pilot,
# then deploy exactly that. The IRIS instance and `module load iris` run the
# system clone, so any git change there reaches every katana_ai_ro member
# at once.
#
#   bin/syspull                 list every file and the commits a pull would bring
#   bin/syspull --apply <sha>   fast-forward the clone to <sha>, on origin/main
#
# The listing ends with the commits and the --apply line for origin/main's
# tip. Quote every commit verbatim in the go-ahead request, naming the
# clone's path; --apply then deploys that commit even if main has moved
# since, and refuses a clone that isn't on main or holds uncommitted edits.
# Both check that every environment version the commit pins has its
# container file on Katana with its digest (bin/syspull-pins.sh): the listing names any that aren't, and
# --apply deploys nothing until bin/envpull puts them in. Both end by
# listing what a pilot tester can't read in the clone
# (bin/pilot-readable.py), and --apply exits 1 if anything is listed, since
# the deploy has happened. Over `ssh katana`.

# The system clone, from lib/katana.sh.
# shellcheck source=lib/katana.sh
. "$(dirname "$(readlink -f "$0")")/../lib/katana.sh" || exit 2
sys="$IRIS_SYSTEM_CLONE"
usage() { echo "usage: bin/syspull [--apply <sha>]" >&2; exit 2; }
# Lists what a pilot tester can't read in the clone; fails if anything.
readable() {
    ssh katana python3 - "$sys" < "$(dirname "$0")/pilot-readable.py"
}
# pins <commit>: names each environment version <commit> pins whose
# container file isn't on Katana;
# fails 1 if any, 2 or more if it can't tell (bin/syspull-pins.sh).
pins() {
    ssh katana bash -s -- "$sys" "$1" < "$(dirname "$0")/syspull-pins.sh"
}

if [ $# -eq 0 ]; then
    # shellcheck disable=SC2016  # expanded on Katana
    ssh katana 'cd '"$sys"' && git fetch -q origin || exit
        echo "System clone '"$sys"': $(git rev-parse --abbrev-ref HEAD) at $(git log -1 --format="%h %s")"
        [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || echo "Not on main: --apply will refuse it."
        dirty=$(git status --porcelain --untracked-files=no)
        [ -z "$dirty" ] || printf "Uncommitted changes, which --apply refuses:\n%s\n" "$dirty"
        own=$(git log --oneline origin/main..HEAD)
        [ -z "$own" ] || printf "Commits of its own, not on main, which a fast-forward refuses:\n%s\n" "$own"
        n=$(git rev-list --count HEAD..origin/main)
        if [ "$n" = 0 ]; then echo "Up to date with origin/main: nothing to deploy."; exit; fi
        echo
        git diff --stat=200 --stat-graph-width=20 HEAD...origin/main
        echo
        echo "$n commits would deploy to the pilot:"
        git log --oneline HEAD..origin/main
        echo
        echo "To deploy them: bin/syspull --apply $(git rev-parse --short origin/main)"' || exit
    out=$(pins origin/main)
    case $? in
        0) ;;
        1) printf '\nThese environment versions have no container file in place on Katana, so --apply refuses until bin/envpull puts them in:\n%s\n' "$out" ;;
        *) printf '\nCouldn'"'"'t check the container files origin/main pins, so --apply will refuse:\n%s\n' "$out" ;;
    esac
    out=$(readable)
    case $? in
        0) ;;
        1) printf '\nPilot testers already can'"'"'t read these in the clone:\n%s\n' "$out" ;;
        *) echo; echo "Couldn't check what pilot testers can read in the clone." ;;
    esac
elif [ $# -eq 2 ] && [ "$1" = --apply ] && [[ "$2" =~ ^[0-9a-f]{7,40}$ ]]; then
    # A form whose container file isn't on Katana stops every job at its start.
    out=$(pins "$2")
    case $? in
        0) ;;
        1) printf '%s\n' "$out" >&2
           echo "syspull: $2 pins environment versions whose container files aren't on Katana; run bin/envpull from main first; nothing deployed." >&2
           exit 1 ;;
        *) printf '%s\n' "$out" >&2
           echo "syspull: couldn't check the container files $2 pins; nothing deployed." >&2; exit 1 ;;
    esac
    # shellcheck disable=SC2016  # $(...) expanded on Katana
    ssh katana 'cd '"$sys"' && git fetch -q origin || exit
        refuse() { echo "syspull: $*; nothing deployed." >&2; exit 1; }
        [ "$(git rev-parse --abbrev-ref HEAD)" = main ] || refuse "the clone is not on main"
        [ -z "$(git status --porcelain --untracked-files=no)" ] || refuse "the clone has uncommitted changes"
        git merge-base --is-ancestor '"$2"' origin/main 2>/dev/null || refuse "'"$2"' is not on origin/main"
        git merge --ff-only '"$2"' && git log -1 --oneline' || exit
    readable || { echo "syspull: deployed, but pilot testers can't read the paths above; fix their ACLs." >&2; exit 1; }
else
    usage
fi

#!/bin/bash
# Show what pulling main into the system clone would deploy to the pilot,
# then deploy exactly that. The system OpenComposer and `module load iris`
# run the system clone, so any git change there reaches every katana_ai_ro
# member at once.
#
#   bin/syspull                 list the commits and files a pull would bring
#   bin/syspull --apply <sha>   fast-forward the clone to <sha>, on origin/main
#
# The listing ends with the --apply line for origin/main's tip. Quote the
# listing in the go-ahead request, naming the clone's path; --apply then
# deploys that commit even if main has moved since. Over `ssh katana`.

sys=/srv/scratch/katana_ai/iris/code
usage() { echo "usage: bin/syspull [--apply <sha>]" >&2; exit 2; }

if [ $# -eq 0 ]; then
    # shellcheck disable=SC2016  # expanded on Katana
    ssh katana 'cd '"$sys"' && git fetch -q origin || exit
        echo "System clone '"$sys"': $(git rev-parse --abbrev-ref HEAD) at $(git log -1 --format="%h %s")"
        dirty=$(git status --porcelain --untracked-files=no)
        [ -z "$dirty" ] || printf "Uncommitted changes, which a pull may refuse:\n%s\n" "$dirty"
        n=$(git rev-list --count HEAD..origin/main)
        if [ "$n" = 0 ]; then echo "Up to date with origin/main: nothing to deploy."; exit; fi
        echo
        echo "$n commits would deploy to the pilot:"
        git log --oneline HEAD..origin/main
        echo
        git diff --stat HEAD origin/main | tail -n 40
        echo
        echo "To deploy them: bin/syspull --apply $(git rev-parse --short origin/main)"'
elif [ $# -eq 2 ] && [ "$1" = --apply ] && [[ "$2" =~ ^[0-9a-f]{7,40}$ ]]; then
    ssh katana "cd $sys && git fetch -q origin &&
        git merge-base --is-ancestor $2 origin/main && git merge --ff-only $2 &&
        git log -1 --oneline"
else
    usage
fi

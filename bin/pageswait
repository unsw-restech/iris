#!/bin/bash
# Wait for GitHub Pages to serve a pushed change: poll one page of the live
# site until it contains a marker string from the new version.
#
#   bin/pageswait <path> <marker>
#   bin/pageswait workflows/microct-2d-segmentation/ 'What a run writes'
#
# <path> is relative to https://docs.restech.unsw.edu.au/iris/ ("" is the
# catalogue). <marker> is a fixed string, not a pattern. Before polling, it
# fetches origin and checks the marker is in origin/main's copy of the page
# (a folder's index.html), since the site is served as committed; a marker
# that isn't, or a folder named without its slash, exits 2 at once rather
# than after three minutes. Each request carries a cache-buster.
# Exits 0 once the marker appears, printing how long that took, or 1 after
# three minutes.

[ $# -eq 2 ] || { echo "usage: bin/pageswait <path> <fixed-string marker>" >&2; exit 2; }
url="https://docs.restech.unsw.edu.au/iris/$1"

# The repo this script is in, so it runs from any clone, worktree or folder.
repo=$(dirname "$(readlink -f "$0")")
git -C "$repo" fetch -q origin 2>/dev/null || echo "pageswait: couldn't fetch origin; checking the marker against origin/main as last fetched." >&2
is_blob() { [ "$(git -C "$repo" cat-file -t "origin/main:$1" 2>/dev/null)" = blob ]; }
# A folder, the catalogue's "" included, serves its index.html. Pages
# answers a folder without its slash with a 301, which curl -f doesn't
# follow, so that path would never go live.
case $1 in
    "" | */) file="${1}index.html" ;;
    *) file=$1
       if ! is_blob "$file" && is_blob "$file/index.html"; then
           echo "pageswait: $1 is a folder, which Pages serves as $1/ (a 301 here): run bin/pageswait $1/ <marker>. Nothing polled." >&2
           exit 2
       fi ;;
esac
is_blob "$file" || { echo "pageswait: origin/main has no $file to serve: nothing polled." >&2; exit 2; }
git -C "$repo" cat-file blob "origin/main:$file" | grep -qF -- "$2" || {
    echo "pageswait: '$2' is not in origin/main's $file: nothing polled. The marker is a fixed string, copied from the page." >&2
    exit 2
}

for i in $(seq 18); do
    if curl -fsS "$url?t=$(date +%s)" 2>/dev/null | grep -qF -- "$2"; then
        echo "live after $(( (i - 1) * 10 ))s: $url"
        exit 0
    fi
    sleep 10
done
echo "pageswait: '$2' not on $url after 3 min" >&2
exit 1

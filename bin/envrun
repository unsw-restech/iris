#!/bin/bash
# bin/envrun [--no-network] [--time-limit <seconds>] [--container <local name>] <env>/<n> <command> [<arg>...]:
# run a command in an environment version's container on the desktop or in
# CI, on CPU, with this clone bound at its own path and the working folder
# kept. bin/check runs the Python tests with it, each workflow's in the
# version its form pins (envs/README.md), with no network and, for a
# workflow's tests, a time limit. Not for Katana, where jobs run the
# container files bin/envpull puts there.
#
# --no-network runs the command with no network: loopback only.
# --time-limit stops the command once it has run that many seconds, says
# so and exits 124. A first run's pull happens before the limit starts.
# The command gets SIGTERM at the limit and SIGKILL 10 seconds later, if
# it is still running then; either way nothing of it is left running.
# Under Docker the container's PID 1 is docker's init (--init), which
# passes SIGTERM on, since a PID 1 of the command's own, such as python,
# would ignore it; one the command ignores ends with `docker kill`, since
# killing the docker client leaves its container running (#197). Under
# Apptainer the command runs in timeout's own process group with no PID
# namespace, so SIGTERM ends it as it would on the host, and timeout's
# SIGKILL to that group ends it if it ignores SIGTERM: nothing leaks, as
# tests/bin/test_envrun_limit.sh shows under each runtime it finds.
# --container runs the command in the container Docker holds under that
# local name instead of the version's published one, under Docker whatever
# the runtime, pulling nothing: the containers workflow runs the tests of
# every workflow pinning an earlier version of the environment, any lab's,
# in a version it has just built, before or without publishing it
# (envs/report-workflows.sh, #150).
#
# The container is the version's digest in lib/katana.sh's digest map; an
# unpublished version, or one not in the map, fails with one line.
#
# With Apptainer, which the desktop's WSL has, as Katana does, the command
# runs under `apptainer exec --cleanenv` in a container file cached by
# digest in IRIS_ENV_CACHE (default ~/.cache/iris/envs): the first run
# pulls it, about 4.7 GB, which takes some minutes, with no login, not
# even the user's Docker login (#201): IRIS's package is public (#132), and
# an author's own, which a fork's pin names, is once the author makes it so.
#
# Without Apptainer, or with IRIS_CONTAINER_RUNTIME=docker, it runs under
# `docker run` as this user, as CI does. A container Docker doesn't hold is
# pulled first with the user's Docker login, if any, and, if Docker can't
# get a credential for it, once more with no login (docker_pull, #247).

set -eo pipefail
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/katana.sh
. "$repo/lib/katana.sh"
usage() { echo "usage: bin/envrun [--no-network] [--time-limit <seconds>] [--container <local name>] <env>/<n> <command> [<arg>...]" >&2; exit 2; }
offline="" limit="" local_name=""
while [[ "${1-}" == --* ]]; do
    case "$1" in
        --no-network) offline=yes; shift ;;
        --time-limit) [[ "${2-}" =~ ^[1-9][0-9]*$ ]] || usage; limit="$2"; shift 2 ;;
        --container) [ -n "${2-}" ] || usage; local_name="$2"; shift 2 ;;
        *) usage ;;
    esac
done
iris_is_env_version "${1-}" && [ $# -ge 2 ] || usage
version="$1"
shift
if [ -n "$local_name" ]; then
    ref="$local_name" runtime=docker
else
    ref="$(iris_env_ref "$version")"
    # bin/review-batch's --apply keeps a copy of this choice (#255);
    # tests/bin/test_review_batch.sh runs both with apptainer on the PATH
    # and without, IRIS_CONTAINER_RUNTIME unset.
    runtime="${IRIS_CONTAINER_RUNTIME:-$(command -v apptainer > /dev/null && echo apptainer || echo docker)}"
fi

# run <command>...: runs the container command, within the time limit if
# there is one. Under Docker, $name names its container.
name=""
run() {
    [ -n "$limit" ] || exec "$@"
    local status=0 start=$SECONDS
    timeout -k 10 "$limit" "$@" || status=$?
    # A command that outlives SIGTERM dies of timeout's SIGKILL to its own
    # process group, 10 seconds past the limit, which takes timeout with it:
    # 137, not 124. A 137 sooner is the command's own, such as an OOM kill.
    [ "$status" != 137 ] || [ $((SECONDS - start)) -lt $((limit + 9)) ] || status=124
    if [ "$status" = 124 ] && [ -n "$name" ]; then
        docker kill "$name" > /dev/null 2>&1 || true
        docker wait "$name" > /dev/null 2>&1 || true
    fi
    [ "$status" != 124 ] || echo "envrun: $version: the command ran past its $limit s limit and was stopped" >&2
    exit "$status"
}

# docker_pull: pulls $ref with the user's Docker login. If that pull fails
# because Docker couldn't get a credential, as when credsStore names
# Docker Desktop's Windows helper and no one is signed in to Windows
# (#247), it pulls once more with DOCKER_CONFIG at an empty config of its
# own, which the public package needs no login for, then removes that
# config. Any other failure, or the retry's, exits with that pull's error.
docker_pull() {
    local err status=0
    # The pull's output goes to stderr, its error into err.
    { err="$(docker pull -q "$ref" 2>&1 >&3)"; } 3>&2 || status=$?
    [ "$status" != 0 ] || return 0
    # Docker's wording, seen on the desktop (#247, 2026-11-21): "Error
    # getting credentials - err: exit status 1, out: `A specified logon
    # session does not exist. ...`".
    if ! grep -qi 'error getting credentials' <<< "$err"; then
        printf '%s\n' "$err" >&2
        exit "$status"
    fi
    echo "envrun: Docker couldn't get a credential for the pull of $version; pulling it again with no login" >&2
    local nologin_config
    nologin_config="$(mktemp -d)"
    trap 'rm -rf "$nologin_config"' EXIT
    echo '{}' > "$nologin_config/config.json"
    status=0
    DOCKER_CONFIG="$nologin_config" docker pull -q "$ref" >&2 || status=$?
    rm -rf "$nologin_config"
    trap - EXIT
    [ "$status" = 0 ] || exit "$status"
}

if [ "$runtime" = docker ]; then
    [ -n "$local_name" ] || docker image inspect "$ref" > /dev/null 2>&1 || docker_pull
    net=()
    [ -z "$offline" ] || net=(--network none)
    # The uid has no passwd entry in the container, so USER carries the
    # name getpass.getuser() needs; torch calls it (CI run 42537470699).
    name="iris-envrun-$$-$RANDOM"
    run docker run --rm --init --name "$name" "${net[@]}" --user "$(id -u):$(id -g)" --env USER="$(id -un)" --env HOME=/tmp --env PYTHONUNBUFFERED=1 \
        --volume "$repo:$repo" --workdir "$PWD" "$ref" "$@"
fi

cache="${IRIS_ENV_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/iris/envs}"
file="$cache/${ref##*@sha256:}.sif"
if [ ! -f "$file" ]; then
    mkdir -p "$cache"
    echo "envrun: pulling $version ($ref) into $cache, once" >&2
    # --authfile at an empty config of its own: Apptainer otherwise reads
    # ~/.docker/config.json, and a credsStore there naming Docker Desktop's
    # Windows helper fails the pull with "error getting credentials" when
    # no one is signed in to Windows. It ignores DOCKER_CONFIG, which
    # docker_pull's retry uses (#201, seen on the desktop 2026-11-24).
    authfile="$(mktemp)"
    trap 'rm -f "$authfile"' EXIT
    echo '{}' > "$authfile"
    status=0
    apptainer pull --disable-cache --force --authfile "$authfile" "$file.part" "docker://$ref" >&2 || status=$?
    rm -f "$authfile"
    trap - EXIT
    [ "$status" = 0 ] ||
        { rm -f "$file.part"; echo "envrun: the pull of $version ($ref) failed" >&2; exit 1; }
    mv "$file.part" "$file"
fi
net=()
[ -z "$offline" ] || net=(--net --network none)
run apptainer exec --cleanenv "${net[@]}" --env PYTHONUNBUFFERED=1 --bind "$repo" --pwd "$PWD" "$file" "$@"

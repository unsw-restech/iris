#!/bin/bash
# bin/iris-python iris.<module> [<arg>...]: run one of lib/'s iris.* Python
# modules in the researcher tools' container, the dispatcher behind the
# bin/iris-* tools, which are shims over it. The container is version
# IRIS_TOOLS_ENV_VERSION's file in IRIS_ENVS_FOLDER (lib/katana.sh,
# envs/README.md), whichever lab a run is from; IRIS_TOOLS_CONTAINER names
# another container file. It runs the module unbuffered (-u), so its lines
# keep their order when logged or piped, with the arguments given, under
# `apptainer exec --cleanenv`, passing only what the tools need: this
# clone's lib/ on the Python path, USER, and IRIS_HOME, the display
# (DISPLAY, XAUTHORITY, for iris-view's napari) and IRIS_URL_FILE (for
# bin/iris-compare) when set. Katana's Apptainer binds /srv, as ADR-0008's
# container jobs 9680569 and 9680570 showed by reading and writing
# /srv/scratch with no --bind, and home and /tmp, which Apptainer binds
# unless its config says otherwise (mount home, mount tmp). A missing
# container stops it with one line. It isn't in module/bin, so `module load
# iris` never puts it on the PATH (ADR-0003).

set -eo pipefail
[[ "$1" == iris.* ]] || { echo "usage: bin/iris-python iris.<module> [<arg>...]" >&2; exit 2; }
name="$1"
shift
LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"
. "$LIB/katana.sh"
container="${IRIS_TOOLS_CONTAINER:-$(iris_env_file "$IRIS_TOOLS_ENV_VERSION")}"
if [ ! -f "$container" ]; then
    echo "ERROR: the IRIS tools' container ($IRIS_TOOLS_ENV_VERSION) is missing at $container. See https://docs.restech.unsw.edu.au/iris/guide/#help." >&2
    exit 1
fi

pass=(--env "PYTHONPATH=$LIB" --env "USER=$USER")
for var in IRIS_HOME DISPLAY XAUTHORITY IRIS_URL_FILE; do
    [ -z "${!var}" ] || pass+=(--env "$var=${!var}")
done
exec apptainer exec --cleanenv "${pass[@]}" "$container" python -u -m "$name" "$@"

#!/bin/bash
# Tick checkboxes in an issue's body, or in its latest Agent Brief comment,
# where triage puts a brief's acceptance criteria: each <box-prefix> names the
# one box whose text starts with it, matched literally, markdown included.
#
#   bin/issue-tick <number> <box-prefix>...
#   bin/issue-tick 95 'The sample dataset arrives' '**Open in Globus** appears'
#
# Edits the body if every prefix matches exactly one box there, else the
# brief if every prefix matches exactly one box in it, else nothing: one call
# ticks boxes in one place. A box already ticked counts as a match and is left
# as is, and lines in ``` fences aren't boxes. Writes no temp file. Exits 0
# and lists what it ticked, 1 if no one place has every prefix's box once, 2
# on usage or a gh failure.

[ $# -ge 2 ] || { echo "usage: bin/issue-tick <number> <box-prefix>..." >&2; exit 2; }
n="$1"
shift
body="$(gh issue view "$n" --json body --jq .body)" || exit 2

# tick <place> <text> <box-prefix>...: prints the count of boxes it ticked,
# their prefixes one per line, then the new text, or fails with a line per
# prefix that matches no box or several in <place>. The prefixes arrive as
# ARGV and the text through the environment, so awk reads no file and leaves
# backslashes alone.
tick() {
    PLACE="$1" TEXT="$2" awk '
BEGIN {
    nl = split(ENVIRON["TEXT"], line, "\n")
    bad = 0
    k = 0
    for (i = 1; i < ARGC; i++) {
        hits = 0
        fenced = 0
        for (j = 1; j <= nl; j++) {
            s = line[j]
            sub(/^[ \t]*/, "", s)
            if (substr(s, 1, 3) == "```") { fenced = !fenced; continue }
            box = substr(s, 1, 6)
            if (!fenced && (box == "- [ ] " || box == "- [x] " || box == "- [X] ") &&
                index(substr(s, 7), ARGV[i]) == 1) { hits++; at = j; open = (box == "- [ ] ") }
        }
        if (hits != 1) {
            printf "issue-tick: \"%s\" matches %d boxes in %s, not 1\n", ARGV[i], hits, ENVIRON["PLACE"] > "/dev/stderr"
            bad = 1
        } else if (open) {
            indent = match(line[at], /[^ \t]/) - 1
            line[at] = substr(line[at], 1, indent) "- [x] " substr(line[at], indent + 7)
            done[++k] = ARGV[i]
        }
    }
    if (bad) exit 1
    print k
    for (i = 1; i <= k; i++) print done[i]
    for (j = 1; j <= nl; j++) print line[j]
}' "${@:3}"
}

# The body first. Failing that, the latest comment with a "## Agent Brief" line:
# its numeric id from its URL on the first line, then its text.
where="#$n"
comment=
if ! out="$(tick "the body" "$body" "$@" 2>&1)"; then
    body_errors="$out"
    brief="$(gh issue view "$n" --json comments --jq '[.comments[] | select(.body | test("(^|\\n)## Agent Brief"))] | last | select(.) | (.url | sub(".*issuecomment-"; "")) + "\n" + .body')" || exit 2
    [ -n "$brief" ] || { echo "$body_errors" >&2; exit 1; }
    comment="$(head -1 <<< "$brief")"
    if ! out="$(tick "the Agent Brief" "$(tail -n +2 <<< "$brief")" "$@" 2>&1)"; then
        { echo "$body_errors"; echo "$out"; } >&2
        exit 1
    fi
    where="#$n's Agent Brief"
fi

k="$(head -1 <<< "$out")"
if [ "$k" = 0 ]; then
    echo "issue-tick: every box already ticked on $where"
    exit 0
fi
new="$(tail -n +$((k + 2)) <<< "$out")"
if [ -z "$comment" ]; then
    printf '%s\n' "$new" | gh issue edit "$n" --body-file - > /dev/null || exit 2
else
    printf '%s\n' "$new" | gh api -X PATCH "repos/{owner}/{repo}/issues/comments/$comment" -F body=@- > /dev/null || exit 2
fi
sed -n "2,$((k + 1))p" <<< "$out" | sed "s/^/ticked on $where: /"

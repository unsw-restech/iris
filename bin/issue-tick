#!/bin/bash
# Tick checkboxes in an issue's body: each <box-prefix> names the one box
# whose text starts with it, matched literally, markdown included.
#
#   bin/issue-tick <number> <box-prefix>...
#   bin/issue-tick 95 'The sample dataset arrives' '**Open in Globus** appears'
#
# Edits the body only if every prefix matches exactly one box; a box already
# ticked counts as a match and is left as is, and lines in ``` fences aren't
# boxes. Writes no temp file. Exits 0 and lists what it ticked, 1 if a prefix
# matches no box or several, 2 on usage or a gh failure.

[ $# -ge 2 ] || { echo "usage: bin/issue-tick <number> <box-prefix>..." >&2; exit 2; }
n="$1"
shift
body="$(gh issue view "$n" --json body --jq .body)" || exit 2

# Prints the count of boxes it ticked, their prefixes one per line, then the
# new body. The prefixes arrive as ARGV and the body through the environment,
# so awk reads no file and leaves backslashes alone.
out="$(BODY="$body" awk '
BEGIN {
    nl = split(ENVIRON["BODY"], line, "\n")
    bad = 0
    k = 0
    for (i = 1; i < ARGC; i++) {
        hits = 0
        fenced = 0
        for (j = 1; j <= nl; j++) {
            s = line[j]
            sub(/^[ \t]*/, "", s)
            if (substr(s, 1, 3) == "```") { fenced = !fenced; continue }
            box = substr(s, 1, 6)
            if (!fenced && (box == "- [ ] " || box == "- [x] " || box == "- [X] ") &&
                index(substr(s, 7), ARGV[i]) == 1) { hits++; at = j; open = (box == "- [ ] ") }
        }
        if (hits != 1) {
            printf "issue-tick: \"%s\" matches %d boxes, not 1\n", ARGV[i], hits > "/dev/stderr"
            bad = 1
        } else if (open) {
            indent = match(line[at], /[^ \t]/) - 1
            line[at] = substr(line[at], 1, indent) "- [x] " substr(line[at], indent + 7)
            done[++k] = ARGV[i]
        }
    }
    if (bad) exit 1
    print k
    for (i = 1; i <= k; i++) print done[i]
    for (j = 1; j <= nl; j++) print line[j]
}' "$@")" || exit 1

k="$(head -1 <<< "$out")"
if [ "$k" = 0 ]; then
    echo "issue-tick: every box already ticked on #$n"
    exit 0
fi
tail -n +$((k + 2)) <<< "$out" | gh issue edit "$n" --body-file - > /dev/null || exit 2
sed -n "2,$((k + 1))p" <<< "$out" | sed "s/^/ticked on #$n: /"

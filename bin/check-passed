#!/bin/bash
# The trees a full bin/check passed on, recorded in this clone's git folder
# (iris/check-passed), shared by its worktrees, so .githooks/pre-push can
# refuse a push to main of a commit no full pass checked. A branch merged
# with a newer main is such a commit: each side passed alone, and the two
# together may not (99a7320 fixed a form test that 3c1201f broke that way).
#
#   bin/check-passed --record    record the tree bin/check just passed on
#   bin/check-passed <commit>    exit 0 if a recorded pass checked <commit>'s
#                                tree, 1 if not, 2 if <commit> isn't one
#
# By tree, not commit: the tree is the tracked files as the working tree
# holds them, uncommitted edits and `git add -N` files included, so a pass
# before committing every edit covers the commit that holds them, and any
# later edit or merge needs a new run. bin/check fails on a file git
# doesn't track, so a pass saw every file the tree holds. A throwaway copy
# of the index makes the tree, since git stash create refuses a git add -N
# file.

cd "$(dirname "$(readlink -f "$0")")/.." || exit 2
passed="$(git rev-parse --git-common-dir)/iris/check-passed"
usage() { echo "usage: bin/check-passed --record | <commit>" >&2; exit 2; }
[ $# -eq 1 ] || usage

if [ "$1" = --record ]; then
    index="$(mktemp)" || exit 2
    trap 'rm -f "$index"' EXIT
    cp "$(git rev-parse --git-path index)" "$index" &&
        GIT_INDEX_FILE="$index" git add -u &&
        tree="$(GIT_INDEX_FILE="$index" git write-tree)" || exit 2
    mkdir -p "${passed%/*}" &&
        echo "$tree $(date -u +%FT%TZ) $(git rev-parse --short HEAD)" >> "$passed"
    exit
fi
[ "${1#-}" = "$1" ] || usage
tree="$(git rev-parse --verify -q "$1^{tree}")" || exit 2
grep -q "^$tree " "$passed" 2> /dev/null

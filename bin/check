check "IRIS contact is patrick.tung@unsw.edu.au" git grep -niE '(restech|imaging)@unsw\.edu\.au' -- ':(exclude)_archive'

# Shell scripts (by .sh or a sh/bash shebang, outside _archive), warnings
# and errors only. CRs are stripped: a Windows working copy can still hold
# CRLF files from before .gitattributes pinned LF.
shellcheck_all() {
    local f files
    mapfile -t files < <(git ls-files | grep -v '^_archive/' | while IFS= read -r f; do
        case "$f" in
            *.sh) echo "$f" ;;
            *) head -n1 "$f" | grep -qE '^#!.*\b(ba)?sh\b' && echo "$f" ;;
        esac
    done)
    for f in "${files[@]}"; do
        tr -d '\r' < "$f" |
            uvx --quiet --from shellcheck-py==0.11.0.1 shellcheck -s bash -S warning -f gcc - |
            sed "s|^-:|$f:|"
    done
}
check "shellcheck" shellcheck_all

# Every tests/bin/test_*.sh, each against fakes or throwaway trees: a
# test prints its failed cases and nothing on success. Each runs under the
# name its "# bin/check name: <name>" line gives, or its path if it has
# none, so a new test runs with no other edit.
for t in tests/bin/test_*.sh; do
    [ -f "$t" ] || continue
    n=$(tr -d '\r' < "$t" | sed -n 's/^# bin\/check name: //p' | head -n1)
    check "${n:-$t}" bash "$t"
done

# Mechanical Python checks only; ruff.toml holds the rule set.
check "ruff" bash -c 'uvx --quiet ruff@0.17.1 check --quiet --output-format concise .'

if selected "synthetic-dataset test"; then
    if [ -x "$PYTHON" ]; then
        # The library's tests once, then each workflow's own.
        for dir in lib/tests workflows/*/tests; do
            ls "$dir"/test_*.py > /dev/null 2>&1 || continue
            out="$("$PYTHON" -m unittest discover -s "$dir" 2>&1)" || {
                echo "FAIL: synthetic-dataset test: $dir"
                echo "$out" | tail -40 | sed 's/^/  /'
                failed=1
            }
        done
    else
        echo "FAIL: synthetic-dataset test: no venv at $PYTHON; build it with envs/imaging/desktop.sh"
        failed=1
    fi
fi

if [ "$ran" = 0 ]; then
    echo "No check name contains '$only'."
    exit 2
fi
if [ "$failed" = 0 ]; then
    if [ -z "$only" ]; then echo "All checks passed."; else echo "Checks matching '$only' passed ($ran run)."; fi
fi
exit "$failed"

# The workflow-owner check, against throwaway repo trees.
check "workflow owner test" bash tests/bin/test_workflow_owner.sh
# The citable-versions check, against throwaway workflow pages.
check "citable versions test" bash tests/bin/test_citable_versions.sh
# The CITATION.cff check, against throwaway trees.
check "CITATION.cff test" bash tests/bin/test_citation_cff.sh
# The module-paths check, against throwaway trees.
check "module paths test" bash tests/bin/test_module_paths.sh

# Mechanical Python checks only; ruff.toml holds the rule set.
check "ruff" bash -c 'uvx --quiet ruff@0.17.1 check --quiet --output-format concise .'

if selected "synthetic-dataset test"; then
    if [ -x "$PYTHON" ]; then
        out="$("$PYTHON" -m unittest discover -s workflows/microct-2d-segmentation/tests 2>&1)" || {
            echo "FAIL: synthetic-dataset test"
            echo "$out" | tail -40 | sed 's/^/  /'
            failed=1
        }
    else
        echo "FAIL: synthetic-dataset test: no venv at $PYTHON; build it with envs/imaging/desktop.sh"
        failed=1
    fi
fi

if [ "$ran" = 0 ]; then
    echo "No check name contains '$only'."
    exit 2
fi
if [ "$failed" = 0 ]; then
    if [ -z "$only" ]; then echo "All checks passed."; else echo "Checks matching '$only' passed ($ran run)."; fi
fi
exit "$failed"

#!/bin/bash
# Every check to pass before committing, as CI runs them on each push
# (.github/workflows/check.yml). Run from anywhere in the clone; it prints
# each failure and exits 1 if there was any.
#
#   bin/check
#   bin/check <text>    run only the checks whose name contains <text>
#                       (the name a failure prints after FAIL:, e.g.
#                       "card status"), for a quick loop while editing;
#                       commit on a full run
#
# The Python tests, lib/tests once and then each workflow's tests/, run in
# the desktop CPU venv, which envs/imaging/desktop.sh builds (IRIS_PYTHON
# names another interpreter). The rendered-form checks and their tests need
# Ruby (once in WSL: sudo apt install ruby; CI's image has it).
# The form tests that need /srv/scratch and the module test need Katana
# and are not run here: see AGENTS.md.

cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
PYTHON="${IRIS_PYTHON:-$HOME/.venvs/iris-imaging/bin/python}"
[ $# -le 1 ] || { echo "usage: bin/check [<text>]; quote a name with spaces" >&2; exit 2; }
only="$1"
failed=0
ran=0

# Whether the check named $1 is selected by the <text> argument; counts
# it in $ran if so.
selected() {
    [[ "$1" == *"$only"* ]] && ran=$((ran + 1))
}

# Run a check; any output is its failure.
check() {
    local name="$1"; shift
    local out
    selected "$name" || return 0
    out="$("$@" 2>&1)"
    if [ -n "$out" ]; then
        echo "FAIL: $name"
        echo "$out" | sed 's/^/  /'
        failed=1
    fi
}

# The site model: the catalogue's cards, the CONTRIBUTING tier table, the
# site's pages and the imaging forms, each parsed once here and queried by
# the rules below as tab-separated lines. A tree without a file has none
# of what it would hold.

# How a script: line opens the quoted heredoc that carries an imaging
# form's entry script, up to its end marker: the definition of an imaging
# form, read from the ERB source. lib/tests/imaging_form.rb's OPENER is the
# whole line as the form renders it, which the rendered-form checks need.
entry_opener="  cat > \"\$RUN_DIR/run.py\" <<'"

# Each catalogue card in index.html, in page order, as <slug> <lab>
# <status>: <lab> is the id of the <div class="lab" id="<lab>"> section
# holding it, which ends at the </div> indented as its opening tag ("-"
# outside every section, "?" in one with no id), and <status> is the label
# after its status-dot ("-" if it has none).
site_cards=$(tr -d '\r' 2>/dev/null < index.html | awk -v OFS='\t' '
    function flush() { if (slug != "") print slug, card_lab, (status == "" ? "-" : status); slug = "" }
    lab != "" && $0 == lab_end { lab = "" }
    /class="lab[" ]/ {
        lab_end = $0; sub(/<.*/, "</div>", lab_end)
        lab = $0
        if (!sub(/.* id="/, "", lab)) lab = "?"
        else sub(/".*/, "", lab)
    }
    match($0, /href="workflows\/[a-z0-9-]+\/"[^>]*class="workflow-card/) {
        flush()
        slug = $0; sub(/.*href="workflows\//, "", slug); sub(/\/".*/, "", slug)
        card_lab = (lab == "" ? "-" : lab); status = ""
    }
    slug != "" && status == "" && /class="status-dot/ {
        status = $0; sub(/.*status-dot[^>]*><\/span> */, "", status); sub(/<.*/, "", status)
    }
    END { flush() }')

# Each workflow the CONTRIBUTING tier table lists, as <slug> <tier>.
site_tiers=$(tr -d '\r' 2>/dev/null < CONTRIBUTING.md | awk -F'|' -v OFS='\t' '/^\| \*\*/ {
    t = $2; gsub(/^ *\*\*|\*\* *$/, "", t)
    n = split($3, w, "`")
    for (i = 2; i <= n; i += 2) print w[i], t }')

# Each of the site's pages that exists: the landing page, the guide, the
# contribute page and every workflow page.
site_pages=$(for f in index.html guide/index.html contribute/index.html workflows/*/index.html; do
    [ -f "$f" ] && echo "$f"
done)

# Each imaging form (GLOSSARY.md): a workflows/*/form.yml.erb whose script
# carries its entry script in a heredoc, a line starting entry_opener. The
# rendered-form checks hold the rest of what its script must hold.
site_imaging_forms=$(for f in workflows/*/form.yml.erb; do
    [ -f "$f" ] && tr -d '\r' < "$f" | awk -v p="$entry_opener" 'index($0, p) == 1 { f = 1 } END { exit !f }' && echo "$f"
done)

cards() { [ -z "$site_cards" ] || printf '%s\n' "$site_cards"; }
tiers() { [ -z "$site_tiers" ] || printf '%s\n' "$site_tiers"; }
pages() { [ -z "$site_pages" ] || printf '%s\n' "$site_pages"; }
workflow_pages() { pages | grep '^workflows/'; }
imaging_forms() { [ -z "$site_imaging_forms" ] || printf '%s\n' "$site_imaging_forms"; }

# The site is served from the /iris/ subpath, so every link is relative
# (../../ from a workflow page).
check "root-absolute links" grep -rn 'href="/' . --include=*.html
check "dead placeholder cards" grep -n 'href="#"' index.html
check "pre-transfer repo URL" grep -rn 'github\.com/PatrickTung/iris\|https://patricktung\.github\.io/iris' . --exclude-dir=.git --exclude-dir=_archive --exclude=AGENTS.md --exclude=check
check "stale account or old repo" grep -rn 'patricktung-unsw\|ares-pages' . --exclude-dir=.git --exclude=AGENTS.md --exclude=check
check "wrong WorkflowHub project; ours is 472" grep -rn 'workflowhub.eu/projects/24' . --include=*.html
# Commit messages carry no AI attribution from any tool: a Co-authored-by
# trailer makes an AI tool's account a GitHub contributor, and removing one
# means rewriting history, so every such trailer fails, human ones included.
# Also fails on *-Session: trailers and "Generated with" lines, by the
# patterns in .githooks/attribution-patterns, which .githooks/commit-msg
# applies before a commit exists. Checked over all of main's history,
# which has been rewritten clean (the old histories are in a private
# backup). Needs a full clone, so CI checks out full history.
# IRIS_CHECK_REPO points it at another repo, as
# tests/bin/test_attribution.sh does.
ai_attribution() {
    local pattern args=()
    while IFS= read -r pattern; do args+=(--grep="$pattern"); done < .githooks/attribution-patterns
    git -C "${IRIS_CHECK_REPO:-.}" log --oneline -i -E "${args[@]}" HEAD
}
check "AI attribution in commit messages" ai_attribution

# A conflicted merge finished with `git commit --no-edit` keeps git's
# commented "# Conflicts:" list in its message; finish one with
# `git commit -m "<message>"` instead. IRIS_CHECK_REPO as above.
conflict_lists() {
    git -C "${IRIS_CHECK_REPO:-.}" log --oneline -E --grep='^# Conflicts:' HEAD
}
check "git's conflict list in commit messages" conflict_lists

# Non-ASCII breaks PowerShell 5.1. Checked with perl, not grep: grep -P
# exits 2 in Git Bash, which reads as clean; [^ -~] flags every line of a
# CRLF working copy (core.autocrlf is on); and WSL's grep missed a real
# non-ASCII byte with both [^[:print:][:space:]] and a \x80-\xff range.
non_ascii_ps1() {
    find . -name '*.ps1' -not -path './.git/*' -print0 |
        xargs -0 -r perl -ne 'if (/[^\x00-\x7f]/) { print "$ARGV\n"; close ARGV }'
}
check "non-ASCII in PowerShell scripts" non_ascii_ps1

usage_tags() {
    local f d
    for f in workflows/*/form.yml.erb; do
        d=$(basename "$(dirname "$f")")
        tr -d '\r' < "$f" | grep -qx "  #PBS -A iris-$d" || echo "$f: no '#PBS -A iris-$d'"
    done
}
check "usage tag matches the folder" usage_tags

# lib/katana.sh holds Katana's constants for every script that can source
# bash. The copies that must stay literal agree with it: each imaging
# form's pane ENV_DIR (ADR-0006), a form's Ruby test for the system clone
# (@apps_dir == "<clone>/workflows"), the modulefile's PATH and the form
# tests' SYSTEM_APPS_DIR. No other file under bin/, lib/, module/ or envs/
# in git's index, notes (*.md, *.in) aside, keeps a constant of its own.
# tests/bin/test_katana_constants.sh runs it on fixture trees.
katana_constants() {
    local IRIS_SYSTEM_CLONE IRIS_ENV_DIR IRIS_PYTHON_MODULE f vals
    # shellcheck source=lib/katana.sh
    . lib/katana.sh || return
    # keep <file> <what> <want> <value>...: each <value> is <want>, and there is one.
    keep() {
        local file="$1" what="$2" want="$3" v
        shift 3
        [ $# -gt 0 ] || { echo "$file: no $what (lib/katana.sh has $want)"; return; }
        for v in "$@"; do
            [ "$v" = "$want" ] || echo "$file: $what is $v; lib/katana.sh has $want"
        done
    }
    for f in $(imaging_forms); do
        mapfile -t vals < <(tr -d '\r' < "$f" | sed -nE 's/^  ENV_DIR=(.*)$/\1/p')
        keep "$f" "ENV_DIR" "$IRIS_ENV_DIR" "${vals[@]}"
    done
    for f in workflows/*/form.yml.erb; do
        [ -f "$f" ] || continue
        mapfile -t vals < <(tr -d '\r' < "$f" | sed -nE 's/.*@apps_dir[^=]*== "([^"]*)".*/\1/p')
        [ ${#vals[@]} = 0 ] || keep "$f" "the system clone's apps_dir" "$IRIS_SYSTEM_CLONE/workflows" "${vals[@]}"
    done
    mapfile -t vals < <(tr -d '\r' 2>/dev/null < module/modulefiles/iris | sed -nE 's/^prepend-path PATH (.*)$/\1/p')
    keep module/modulefiles/iris "the PATH it prepends" "$IRIS_SYSTEM_CLONE/module/bin" "${vals[@]}"
    for f in workflows/*/tests/*.rb; do
        [ -f "$f" ] || continue
        mapfile -t vals < <(tr -d '\r' < "$f" | sed -nE 's/^ *SYSTEM_APPS_DIR = "([^"]*)".*/\1/p')
        [ ${#vals[@]} = 0 ] || keep "$f" "SYSTEM_APPS_DIR" "$IRIS_SYSTEM_CLONE/workflows" "${vals[@]}"
    done
    git grep -nF -e "$IRIS_SYSTEM_CLONE" -e "$IRIS_ENV_DIR" -e "$IRIS_PYTHON_MODULE" -- bin lib module envs ':(exclude)*.md' ':(exclude)*.in' \
        ':(exclude)lib/katana.sh' ':(exclude)module/modulefiles/iris' |
        sed 's/$/  (take it from lib\/katana.sh)/'
}
check "Katana constants match lib/katana.sh" katana_constants

# Print form lines that break a rule, by top-level section: no heredoc in
# script: (every line there stays indented), no Ruby #{} in check: (it
# collides with OpenComposer's own substitution). An imaging form's script
# carries its entry script in one, so the rendered-form checks hold its
# heredoc rule instead.
form_sections() {
    local f imaging
    for f in workflows/*/form.yml.erb; do
        imaging=0; imaging_forms | grep -qxF "$f" && imaging=1
        tr -d '\r' < "$f" | awk -v f="$f" -v imaging="$imaging" '
            /^[A-Za-z_]+:/ { sec = $1 }
            sec == "script:" && /<</ && !imaging { print f ":" NR ": heredoc in script: (build files with printf '%s\\n')" }
            sec == "check:" && /#\{/ { print f ":" NR ": #{} in check: (use + concatenation)" }'
    done
}
check "form script: and check: sections" form_sections

# Ruby renders the forms as OpenComposer does; without it a rule that needs
# it fails, so a local pass means what a CI pass does.
need_ruby() {
    command -v ruby > /dev/null ||
        { echo "ruby not found: install it once with sudo apt install ruby"; return 1; }
}

# Each imaging form's script as the form renders it holds, in order, its
# PBS header with the usage tag, CODE and its guard, ENV_DIR, the job
# library, the banner, the heredoc holding its entry script byte for byte,
# the call recording the run's code and the python call on run.py, with no
# other heredoc, and its entry script holds no #{ or <% (ADR-0006). lib/tests/imaging_form.rb
# holds those parts and lib/tests/test_imaging_form.rb breaks each one.
rendered_scripts() {
    need_ruby || return
    # shellcheck disable=SC2046 # one word per path
    [ -z "$(imaging_forms)" ] || ruby lib/tests/imaging_form.rb $(imaging_forms)
}
check "imaging forms' rendered scripts" rendered_scripts

# The Ruby tests that need only Ruby and git; those needing /srv/scratch
# (each workflow's tests/test_form.rb) run in bin/katana-test.
ruby_tests() {
    local t out
    need_ruby || return
    for t in lib/tests/test_*.rb; do
        [ -f "$t" ] || continue
        out="$(ruby "$t" 2>&1)" || { echo "$t:"; echo "$out" | tail -40; }
    done
}
check "rendered-form tests" ruby_tests

# hello-world's job runs its own clone's code too: CODE comes from
# @apps_dir, guarded because OpenComposer re-reads the form on submit with
# @apps_dir unset. The rendered-form checks cover the imaging forms.
code_guard() {
    local f
    for f in workflows/*/form.yml.erb; do
        imaging_forms | grep -qxF "$f" && continue
        tr -d '\r' < "$f" | grep -qxF '<% code = @apps_dir ? File.expand_path(File.join(@apps_dir, @OC_DIR_NAME)) : "" %>' &&
            tr -d '\r' < "$f" | grep -qxF '  CODE="<%= code %>"' || echo "$f"
    done
}
check "other forms set CODE from a guarded @apps_dir" code_guard

# Local icon files don't resolve with an absolute apps_dir.
manifest_icons() {
    local f
    for f in workflows/*/manifest.yml; do
        tr -d '\r' < "$f" | grep -qE '^icon: bi-[a-z0-9-]+$' || echo "$f"
    done
}
check "manifests use a built-in bi- icon" manifest_icons

# Scripts run by path need the executable bit in git; core.fileMode is off
# on the Windows mount, so chmod alone does not record it.
exec_bits() {
    git ls-files -s bin 'envs/*.sh' 'tests/bin/test_*.sh' .githooks/commit-msg | awk '$1 != "100755" { print $4 }'
}
check "scripts run by path are 100755 (git update-index --chmod=+x)" exec_bits

# `module load iris` puts module/bin on the PATH (ADR-0003), so it holds
# exactly iris-view and iris-compare, each a relative link to its script
# in bin/, which also holds maintainer tools. Read from git's index, since
# a clone with core.symlinks off checks links out as plain files.
# tests/bin/test_module_commands.sh runs it on fixture repos.
module_commands() {
    local mode blob path name target want=" iris-compare iris-view " got=" "
    while read -r mode blob _ path; do
        name="${path#module/bin/}"
        got+="$name "
        if [ "$mode" != 120000 ]; then echo "$path: not a symlink"; continue; fi
        target=$(git cat-file blob "$blob")
        if [[ "$target" == /* ]]; then echo "$path: links to $target; make it relative (../../bin/$name)"; continue; fi
        [ "$(realpath -ms --relative-to=. "module/bin/$target")" = "bin/$name" ] &&
            [ "$(git ls-files -s "bin/$name" | cut -c1-3)" = 100 ] ||
            echo "$path: links to $target, not to the script bin/$name"
    done < <(git ls-files -s module/bin | tr '\t' ' ')
    [ "$(tr ' ' '\n' <<< "$got" | grep . | sort | tr '\n' ' ' | sed 's/^/ /')" = "$want" ] ||
        echo "module/bin: holds${got% }; it holds iris-view and iris-compare only"
}
check "module commands are iris-view and iris-compare linked into bin/" module_commands

# Print $2 (a link in $1, relative to $3) if it reaches no file, or if its
# #fragment names no id there.
resolve_link() {
    local from="$1" link="$2" base="$3" path frag target
    path="${link%%#*}"
    frag=""; [[ "$link" == *"#"* ]] && frag="${link#*#}"
    if [ -z "$path" ]; then target="$from"
    elif [ -d "$base/$path" ]; then target="$base/$path/index.html"
    else target="$base/$path"
    fi
    if [ ! -f "$target" ]; then echo "$from: $link: no such file"
    elif [ -n "$frag" ] && ! grep -qF " id=\"$frag\"" "$target"; then echo "$from: $link: no id=\"$frag\""
    fi
}

# resolve_link each link read from stdin, found in $1, relative to $2.
resolve_each() {
    local link
    tr -d '\r' | sort -u | while IFS= read -r link; do resolve_link "$1" "$link" "$2"; done
}

# Every local link resolves, anchor included: relative hrefs in the site's
# pages, the README's relative links, and docs.restech.unsw.edu.au/iris/ URLs
# in any tracked file outside the desktop tools and their tests.
local_links() {
    local f url
    for f in $(pages); do
        grep -oE 'href="[^"]*"' "$f" | sed 's/^href="//; s/"$//' | grep -vE '^(https?|mailto):' |
            resolve_each "$f" "$(dirname "$f")"
    done
    grep -oE '\]\([^)]+\)' README.md | sed 's/^](//; s/)$//' | grep -vE '^https?:' | resolve_each README.md .
    git grep -lE 'docs\.restech\.unsw\.edu\.au/iris/' -- ':(exclude)_archive' ':(exclude)bin' ':(exclude)tests' | while IFS= read -r f; do
        tr -d '\r' < "$f" | grep -oE 'https://docs\.restech\.unsw\.edu\.au/iris/[^]) "<>`]*' |
            while IFS= read -r url; do echo "./${url#https://docs.restech.unsw.edu.au/iris/}"; done |
            resolve_each "$f" .
    done
}
check "broken local links" local_links

# The README's repo map names paths a researcher can open; <workflow>
# stands for any workflow folder.
readme_paths() {
    local p first
    tr -d '\r' < README.md | grep '^| `' | cut -d'|' -f2 | grep -oE '`[^`]+`' | tr -d '`' |
        while IFS= read -r p; do
            first=$(compgen -G "${p//<workflow>/*}" | head -n1)
            [ -n "$first" ] && [ -e "$first" ] || echo "README.md: $p does not exist"
        done
}
check "README repo map names real paths" readme_paths

# During the pilot, every Run button opens the system OnDemand (/pun/sys/),
# the README and the landing page say only pilot testers can run workflows,
# and the contribute page, CONTRIBUTING and the proposal form say proposals
# open at launch. Launch removes every notice at once (CONTRIBUTING.md,
# Status). Buttons still on the dev OnDemand (/pun/dev/) work for no one
# else, so they need every notice.
prelaunch_notice() {
    local dev sys file text kept=() gone=()
    dev=$(git grep -l 'pun/dev/OpenComposer' -- '*.html' ':(exclude)_archive')
    sys=$(git grep -l 'pun/sys/OpenComposer' -- '*.html' ':(exclude)_archive')
    if [ -n "$dev" ] && [ -n "$sys" ]; then
        echo "Run buttons are split: /pun/dev/ in" $dev "and /pun/sys/ in" $sys
        return
    fi
    while IFS='|' read -r file text; do
        if grep -q "$text" "$file"; then
            kept+=("$file (\"$text\")")
        else
            gone+=("$file (\"$text\")")
        fi
    done <<'NOTICES'
README.md|work only for pilot testers until launch
index.html|work only for pilot testers until launch
contribute/index.html|Proposals open at launch
CONTRIBUTING.md|Proposals open at launch
.github/ISSUE_TEMPLATE/proposal.yml|Proposals open at launch
NOTICES
    if [ -n "$dev" ]; then
        for file in "${gone[@]}"; do
            echo "$file: the pre-launch notice is gone, but Run buttons in" $dev "still use /pun/dev/"
        done
    elif [ ${#gone[@]} -gt 0 ]; then
        for file in "${kept[@]}"; do
            echo "$file: launch removed the other pre-launch notices; remove this one too"
        done
    fi
}
check "pre-launch notices match the Run buttons" prelaunch_notice

# A card's status label follows its workflow's row in the CONTRIBUTING tier table,
# whose row titles are the tier names in label[] below.
# tests/bin/test_card_status.sh runs it on fixture trees.
card_status() {
    awk -F'\t' '
        BEGIN {
            label["Run and verified"] = "Active"
            label["Run, browser run pending"] = "Testing"
            label["Planned"] = "Planned"
            label["Unmaintained"] = "no card"
        }
        FNR == NR {
            if (!($2 in label)) {
                if (!($2 in told)) {
                    names = ""
                    for (k in label) names = names (names == "" ? "" : "; ") k
                    print "CONTRIBUTING.md: tier \"" $2 "\" is not one of: " names
                }
                told[$2] = 1
                next
            }
            want[$1] = label[$2]
            next
        }
        $3 == "-" { print "index.html: " $1 "'"'"'s card has no status label"; next }
        !($1 in want) { print "index.html: " $1 " has no row in the CONTRIBUTING tier table"; next }
        $3 != want[$1] { print "index.html: " $1 " reads " $3 "; its CONTRIBUTING tier says " want[$1] }
    ' <(tiers) <(cards)
}
check "card status matches the CONTRIBUTING tier table" card_status

# The catalogue groups cards by lab: each card sits in a lab section (see
# site_cards), and its page's breadcrumb links that section (../../#<lab>).
# tests/bin/test_lab_sections.sh runs it on fixture trees.
lab_sections() {
    local slug lab
    cards | while IFS=$'\t' read -r slug lab _; do
        case "$lab" in
            -) echo "index.html: $slug's card is outside every lab section"; continue ;;
            \?) echo "index.html: $slug's card is in a lab section with no id"; continue ;;
        esac
        [ -f "workflows/$slug/index.html" ] &&
            tr -d '\r' < "workflows/$slug/index.html" | grep 'class="breadcrumb"' |
            grep -qF "href=\"../../#$lab\"" ||
            echo "workflows/$slug/index.html: the breadcrumb doesn't link its card's lab (../../#$lab)"
    done
}
check "cards sit in a lab section their page's breadcrumb links" lab_sections

# Run and verified means a real job ran from a clone (#53: two forms sat in
# this tier without one), so a line outside the table cites a job for each
# of them: "`<slug>`", then "(job <ID>" with no backtick between. A renamed
# tier fails card_status.
# tests/bin/test_tier_jobs.sh runs it on fixture trees.
tier_jobs() {
    local doc slug
    doc=$(tr -d '\r' < CONTRIBUTING.md)
    for slug in $(tiers | awk -F'\t' '$2 == "Run and verified" { print $1 }'); do
        grep -v '^|' <<< "$doc" | grep -qE "\`$slug\`[^\`]*\(job [0-9]+" ||
            echo "CONTRIBUTING.md: $slug is Run and verified but no line cites its job: \"\`$slug\` ... (job <ID>\", with no backtick between them"
    done
}
check "Run and verified workflows cite a job" tier_jobs

# An unmaintained workflow sits in the Unmaintained row of the CONTRIBUTING
# tier table, and its page, which stays so its citable versions and cited
# commits still lead somewhere, carries the unmaintained-banner. Demoting
# one takes the Run button off the page, the card off the catalogue, the
# form into _archive/<slug>/, so OpenComposer stops serving it, and its
# line out of CODEOWNERS, since it has no workflow owner; this fails
# until every step is done, whichever of the row or the banner came first.
# tests/bin/test_unmaintained.sh runs it on fixture trees.
unmaintained() {
    local page slug rows banners
    rows=$(tiers | awk -F'\t' '$2 == "Unmaintained" { print $1 }')
    banners=$(workflow_pages | xargs -r grep -l 'class="unmaintained-banner"' | xargs -r -n1 dirname | xargs -r -n1 basename)
    for slug in $(sort -u <<< "$rows"$'\n'"$banners"); do
        page="workflows/$slug/index.html"
        if [ ! -f "$page" ]; then
            echo "$page: $slug is Unmaintained, but its page is gone; it stays, with the unmaintained-banner"
            continue
        fi
        grep -qx "$slug" <<< "$rows" ||
            echo "$page: has the unmaintained-banner, but the CONTRIBUTING tier table doesn't list $slug as Unmaintained"
        grep -qx "$slug" <<< "$banners" ||
            echo "$page: $slug is Unmaintained in the CONTRIBUTING tier table, but its page has no unmaintained-banner"
        grep -qE 'class="run-btn|/pun/(dev|sys)/OpenComposer/' "$page" &&
            echo "$page: Unmaintained, but has a Run button"
        cards | cut -f1 | grep -qx "$slug" &&
            echo "index.html: $slug is Unmaintained, but has a catalogue card"
        [ -e "workflows/$slug/form.yml.erb" ] &&
            echo "workflows/$slug/form.yml.erb: $slug is Unmaintained; move its form to _archive/$slug/"
        tr -d '\r' 2>/dev/null < .github/CODEOWNERS | grep -qE "^/workflows/$slug/ " &&
            echo ".github/CODEOWNERS: $slug is Unmaintained; remove its /workflows/$slug/ line"
    done
}
check "unmaintained workflows have no Run button, card, live form or CODEOWNERS line" unmaintained

# The guide owns staging and viewing (CONTRIBUTING.md step 5): its data mover host,
# scratch quota, WinSCP note, Globus link (app.globus.org) and Katana scratch
# collection ID stay out of workflow pages, so a change of collection edits the
# guide and the ID in this pattern, and no workflow page.
guide_copies() {
    workflow_pages | xargs -r grep -H -n -i 'kdm\.restech\|128 GB\|winscp\|app\.globus\.org\|ee4d18e3-a68d-447a-8acc-8b97771239d4'
}
check "workflow page repeats the guide (link guide/#stage or #view)" guide_copies

# Page text keeps to GLOSSARY.md's terms (CODING_STANDARDS.md). Only the
# Avoid words that have drifted onto pages are matched, since most Avoid
# words (sync, results, app) are fine in other senses: "scan" for Volume,
# "upload" for Staging, and "Files app" for Files (#90).
check "page uses a glossary Avoid word (see GLOSSARY.md)" \
    git grep -niE '\bscans?\b|\bupload|files app' -- '*.html' ':(exclude)_archive'

# Every catalogue workflow with a form names its workflow owner on its
# page, under the description, as <p class="wf-owner"> linking their GitHub
# profile, and .github/CODEOWNERS has a "/workflows/<slug>/ @<login>" line
# so that owner reviews changes to its folder. hello-world is onboarding,
# and Planned workflows have no form. Every /workflows/ line names a folder
# with a form.
workflow_owner() {
    local f d owners p login
    owners=$(tr -d '\r' 2>/dev/null < .github/CODEOWNERS)
    grep -oE '^/workflows/[^ ]*' <<< "$owners" | while IFS= read -r p; do
        [[ "$p" =~ ^/workflows/[a-z0-9-]+/$ ]] && [ -f ".${p}form.yml.erb" ] ||
            echo ".github/CODEOWNERS: $p is not a workflow folder with a form (/workflows/<slug>/)"
    done
    for f in workflows/*/form.yml.erb; do
        d=$(dirname "$f")
        [ "$d" = workflows/hello-world ] && continue
        login=$(tr -d '\r' 2>/dev/null < "$d/index.html" |
            sed -nE 's|.*<p class="wf-owner">Workflow owner: <a href="https://github\.com/([A-Za-z0-9-]+)".*|\1|p' | head -n1)
        if [ -z "$login" ]; then
            echo "$d/index.html: no workflow owner (<p class=\"wf-owner\">Workflow owner: <a href=\"https://github.com/<login>\" ...)"
        elif ! grep -qE "^/$d/ +@" <<< "$owners"; then
            echo ".github/CODEOWNERS: no \"/$d/ @$login\" line"
        elif ! grep -E "^/$d/ " <<< "$owners" | grep -qE " @$login( |$)"; then
            echo ".github/CODEOWNERS: /$d/ does not name @$login, the owner on its page"
        fi
    done
}
check "workflow owner on the page and in CODEOWNERS" workflow_owner

# A workflow page lists its citable versions by DOI, date and commit, never
# as a version number (ADR-0002): one line each in its "Cite this workflow"
# block (id="cite"), a WorkflowHub workflow DOI with a YYYY-MM-DD date and
# a <code> commit. Any other DOI on the page fails, so Katana's stays in the
# README. "No citable version yet" goes when the first DOI is pasted in.
# tests/bin/test_citable_versions.sh runs it on fixture trees.
citable_versions() {
    local f
    for f in $(workflow_pages); do
        tr -d '\r' < "$f" | awk -v f="$f" '
            / id="cite"/ { cite = 1 }
            cite && /<\/details>/ { cite = 0 }
            cite && /(^|[^A-Za-z0-9])v[0-9]+([^A-Za-z0-9]|$)|[Vv]ersion [0-9]/ {
                print f ":" NR ": a version label; list it by DOI, date and commit only" }
            cite && /No citable version yet/ { none_line = NR }
            /10\.[0-9][0-9][0-9][0-9]+\// {
                has_doi = 1
                line = $0
                while (match(line, /10\.[0-9][0-9][0-9][0-9]+\/[^ "<>]+/)) {
                    doi = substr(line, RSTART, RLENGTH); line = substr(line, RSTART + RLENGTH)
                    if (doi !~ /^10\.48546\/workflowhub\.workflow\.[0-9]+\.[0-9]+$/)
                        print f ":" NR ": " doi " is not a WorkflowHub workflow DOI (10.48546/workflowhub.workflow.<id>.<n>)"
                }
                if ($0 !~ /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) print f ":" NR ": a DOI with no YYYY-MM-DD date"
                if ($0 !~ /<code>[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]+<\/code>/) print f ":" NR ": a DOI with no <code> commit"
            }
            END { if (none_line && has_doi) print f ":" none_line ": \"No citable version yet\" beside a listed DOI" }'
    done
}
check "citable versions on workflow pages" citable_versions

# CITATION.cff's identifiers list every citable version's DOI, and only
# those: the same set as the workflow pages (CONTRIBUTING.md, Registering
# on WorkflowHub, step 6). Only the identifiers block counts, without
# its comments: a # at the start of a line or after whitespace, so a URL's
# #fragment stays. tests/bin/test_citation_cff.sh runs it on fixture trees.
citation_cff() {
    local re='10\.48546/workflowhub\.workflow\.[0-9]+\.[0-9]+' pages cff
    pages=$(workflow_pages | xargs -r grep -ohE "$re" | sort -u)
    cff=$(tr -d '\r' < CITATION.cff | awk '/^[^ \t#]/ { ids = /^identifiers:/ } ids { sub(/(^|[ \t])#.*/, ""); print }' |
        grep -oE "$re" | sort -u)
    comm -23 <(echo "$pages") <(echo "$cff") | grep . | sed 's/$/ is on a workflow page; add it to identifiers in CITATION.cff/'
    comm -13 <(echo "$pages") <(echo "$cff") | grep . | sed 's/$/ is in CITATION.cff but on no workflow page/'
}
check "CITATION.cff and workflow pages list the same citable versions" citation_cff

# A rename reaches every copy of the name: each page's top-bar logo reads
# the same (and has one), and the citation example in README's quoted
# lines gives CITATION.cff's title, which must be a double-quoted title:.
# The logo is read with line breaks removed, so it may wrap.
# tests/bin/test_site_name.sh runs it on fixture trees.
site_name() {
    local f logo logos="" title
    for f in $(pages); do
        logo=$(tr -d '\r\n' < "$f" | grep -o 'nav-logo-text">[^<]*' | head -1 |
            sed 's/^nav-logo-text">//; s/^[[:space:]]*//; s/[[:space:]]*$//')
        if [ -z "$logo" ]; then echo "$f has no nav-logo-text logo"; else logos+="$f: $logo"$'\n'; fi
    done
    if [ "$(sed 's/^[^:]*: //' <<< "$logos" | grep . | sort -u | wc -l)" -gt 1 ]; then
        echo "the pages' logos differ; make them read the same:"
        printf '%s' "$logos"
    fi
    [ -f CITATION.cff ] && [ -f README.md ] || return 0
    title=$(tr -d '\r' < CITATION.cff | sed -n 's/^title: *"\(.*\)" *$/\1/p')
    if [ -z "$title" ]; then
        echo "CITATION.cff has no double-quoted title: line"
    elif ! tr -d '\r' < README.md | grep -E '^[[:space:]]*>' | grep -qF -- "*$title*"; then
        echo "README.md's citation example (a > quoted line) doesn't give CITATION.cff's title, *$title*"
    fi
}
check "page logos match; README cites CITATION.cff's title" site_name

# Researchers reach iris-view and iris-compare with `module load iris`
# (ADR-0003), so no page, form or README gives a full path to either: a
# "/iris-view" or "/iris-compare" in its text fails, as does a path join
# ending in "iris-..." (File.join(bin, "iris-view")) in a form's <%= %>
# output. A form's Ruby code blocks (<% %>, <%- -%>) are skipped, since
# that is where the dev-clone branch builds its full paths. iris-rebuild
# isn't in the module, so its full path stays; maintainer text
# (CONTRIBUTING, bin/) and _archive/ aren't read. Pages are read from
# git's index, as local_links does, so a copy such as a worktree under
# .claude/ isn't. tests/bin/test_module_paths.sh runs it on fixture trees.
module_paths() {
    local re='/iris-(view|compare)([^A-Za-z0-9_-]|$)' f
    git grep -nE "$re" -- '*.html' ':(exclude)_archive'
    [ ! -f README.md ] || grep -nE "$re" README.md | sed 's|^|README.md:|'
    for f in workflows/*/form.yml.erb; do
        [ -f "$f" ] || continue
        tr -d '\r' < "$f" | awk -v f="$f" -v re="$re" '
            {
                line = $0; out = ""
                while (line != "") {
                    if (code) {
                        i = index(line, "%>"); if (!i) break
                        line = substr(line, i + 2); code = 0; continue
                    }
                    i = index(line, "<%"); if (!i) { out = out line; break }
                    out = out substr(line, 1, i - 1); line = substr(line, i + 2)
                    if (substr(line, 1, 1) == "=") out = out "<%"; else code = 1
                }
                if (out ~ re || out ~ /, *"iris-(view|compare)"/) print f ":" NR ": " $0
            }'
    done
}
check "full paths to iris-view or iris-compare (give module load iris, then the command)" module_paths


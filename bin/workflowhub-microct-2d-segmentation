#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's quoting undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"; fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM${e}[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line). Idempotent. Creates ENV_FILE at mode 0600; writes through a symlink
# and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────


# Registers microct-2d-segmentation on WorkflowHub, the worked example of
# spec #58 (ADR-0002: one entry per catalogue workflow, imported from main,
# type Other, citable versions frozen from main). The workflow owner runs
# it on the desktop (for this workflow, Patrick, who is also the
# maintainer); it needs no credentials, only a browser signed in to
# WorkflowHub as a member of Team 472. It stops for a yes before Publish
# and before Generate a DOI, and ends with the comment for #76.
#
#   bin/workflowhub-microct-2d-segmentation
#
# Answers are kept in $IRIS_WIZARD_ENV (default below, outside the repo),
# so a re-run offers them back: press Enter through the stages already done.
# A workflow owner registering another workflow copies this script and
# changes the values in the block below, setting TICKET empty.
#
# It sits in bin/ with the other desktop tools, so Pages serves it like
# every file; that's harmless, since it holds no credentials and writes
# its answers outside the repo.

SLUG=microct-2d-segmentation
# The manifest's name, prefixed so it reads on its own in WorkflowHub's search.
TITLE="UNSW HPC Katana - microCT 2D Segmentation (U-Net)"
REPO_URL=https://github.com/unsw-restech/iris
BRANCH=main
MAIN_FILE=workflows/$SLUG/src/run.py
WF_TYPE=Other
LICENCE=Apache-2.0
TEAM_ID=472
TEAM_NAME="UNSW ResTech"
TEAM_URL=https://workflowhub.eu/projects/$TEAM_ID
OWNER="Patrick Tung"
OWNER_ORCID=0000-0002-2741-3177   # empty it in a copy, and the first stage asks
ORG_CREATOR="UNSW Research Technology Services"
PAGE_URL=https://docs.restech.unsw.edu.au/iris/workflows/$SLUG/
TAGS="microCT, segmentation, U-Net, deep learning, imaging, HPC"
# The issue the last stage reports on: #76 checks, for spec #58, that a
# frozen snapshot records its commit. Empty skips that stage.
TICKET=76
# The workflow page's lead paragraph, then the manifest's description, in
# the glossary's terms.
DESCRIPTION="Label a few slices of a microCT volume, and IRIS trains a 2D U-Net on them and segments the whole volume slice by slice. Each run is recorded, so you can compare runs with different settings side by side.

IRIS is UNSW Research Technology Services' AI imaging gateway on the Katana cluster. Pick a dataset folder in your scratch holding volume/ (the volume's netCDF blocks) and train/images/ with train/labels/ (TIFF pairs with matching names, 0 = unlabelled). The job runs in the pre-built IRIS imaging environment, so nothing is installed.

Everything lands in <dataset>/runs/<job ID>/: the label volume, the trained weights, the run's record and the IRIS commit that ran, as the page lists them: ${PAGE_URL}#run-directory. To cite a run, follow \"Cite this workflow\" on the page below, and give that commit.

Documentation: $PAGE_URL"

ENV_FILE="${IRIS_WIZARD_ENV:-$HOME/.config/iris/workflowhub-$SLUG.env}"
mkdir -p "$(dirname "$ENV_FILE")"

# paste_block "label" "text" prints text flush left between rules, so it
# copies cleanly into a WorkflowHub field.
paste_block() {
  printf '\n  %s%s:%s\n%s----%s\n%s\n%s----%s\n' "$BOLD" "$1" "$RESET" "$DIM" "$RESET" "$2" "$DIM" "$RESET"
}

# stop_here "why" ends the run cleanly at a gate the workflow owner declined.
stop_here() {
  printf '\n'
  warn "$1"
  note "Nothing after this point was done. Re-run the wizard when ready; your answers are kept in $ENV_FILE."
  exit 0
}

# wh_read <field> prints one field of the entry at $WH_ENTRY_URL from
# WorkflowHub's public JSON API: title, licence, or the newest snapshot's
# commit or doi. Prints nothing until the entry is public, or if the API
# can't be reached, so a caller falls back to asking.
wh_read() {
  { curl -fsS -H 'Accept: application/vnd.api+json' "$WH_ENTRY_URL" | python3 -I -c '
import json, sys
attrs = json.load(sys.stdin)["data"]["attributes"]
newest = max(attrs.get("versions") or [{}], key=lambda v: v.get("version", 0))
print({"title": attrs.get("title"), "licence": attrs.get("license"),
       "commit": newest.get("commit"), "doi": newest.get("doi")}[sys.argv[1]] or "")' "$1"; } 2>/dev/null || true
}

ok() { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }

# expect_field <field> <wanted> warns, and fails, if the live entry's field
# differs.
expect_field() {
  local got; got=$(wh_read "$1")
  if [[ -z "$got" ]]; then warn "couldn't read the entry's $1 from WorkflowHub; check it by eye"
  elif [[ "$got" != "$2" ]]; then warn "the entry's $1 is \"$got\", not \"$2\""; return 1
  else ok "$1: $got"; fi
}

if [[ -n "$TICKET" ]]; then TOTAL_STAGES=8; else TOTAL_STAGES=7; fi

banner "Register $SLUG on WorkflowHub"

# ──────────────────────────────────────────────────────────────────────────
stage "Sign in, and check you are in Team $TEAM_ID"
say "If a browser opens on a different machine from the one you're reading this on,"
say "click the printed URLs instead."
open_url "$TEAM_URL"
step "Sign in to WorkflowHub (top right) if you aren't already."
step "On the $TEAM_NAME team page, check you're listed under its people."
note "Registering into a team needs membership of it."
pause "Signed in and listed? Press Enter."
printf '\n'
# The workflow owner's ORCID iD goes in the creators list; asked for only
# when OWNER_ORCID above is empty or malformed.
if ! [[ "${OWNER_ORCID:-}" =~ ^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$ ]]; then
  printf '  %s%sOWNER ORCID NEEDED%s\n' "$BOLD" "$YELLOW" "$RESET"
  say "Your ORCID iD goes in the creators list."
  say "Find it at https://orcid.org/my-orcid or on your WorkflowHub profile."
fi
until [[ "${OWNER_ORCID:-}" =~ ^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$ ]]; do
  [[ -n "${OWNER_ORCID:-}" ]] && warn "that isn't an ORCID iD like 0000-0002-1825-0097"
  ask OWNER_ORCID ">>> ENTER YOUR ORCID iD (0000-0000-0000-0000):"
  OWNER_ORCID="${OWNER_ORCID#https://orcid.org/}"
done
write_env OWNER_ORCID "$OWNER_ORCID"

# ──────────────────────────────────────────────────────────────────────────
stage "Import the repo from git"
# The commit main is at when imported, to compare with what the entry shows.
WH_IMPORT_COMMIT=$(_existing WH_IMPORT_COMMIT || true)
if [[ -z "$WH_IMPORT_COMMIT" ]] || ! confirm "Already imported, at ${WH_IMPORT_COMMIT:0:12}? No reads $BRANCH again"; then
  WH_IMPORT_COMMIT=$(git ls-remote "$REPO_URL" "refs/heads/$BRANCH" 2>/dev/null | cut -f1)
fi
if [[ -n "$WH_IMPORT_COMMIT" ]]; then
  write_env WH_IMPORT_COMMIT "$WH_IMPORT_COMMIT"
  note "$BRANCH is at $WH_IMPORT_COMMIT; WorkflowHub imports the latest commit."
else
  warn "couldn't read $BRANCH's commit from $REPO_URL; note it from GitHub instead"
fi
open_url "https://workflowhub.eu/workflows/new"
step "If that isn't the new-workflow wizard: Create (top menu) → Workflow."
step "Choose the option to import a Git repository."
paste_block "Git repository URL" "$REPO_URL"
step "Click Register."
paste_block "Branch (not a release tag)" "$BRANCH"
step "Click Register again."
paste_block "Main workflow file (pick it from the list)" "$MAIN_FILE"
step "Leave Abstract CWL and Diagram empty."
step "If it asks for the workflow type, pick: $WF_TYPE"
step "Click Continue."
pause "On the metadata step? Press Enter."

# ──────────────────────────────────────────────────────────────────────────
stage "Title and description"
paste_block "Title" "$TITLE"
paste_block "Description (replace whatever was imported)" "$DESCRIPTION"
pause "Both pasted? Press Enter."

# ──────────────────────────────────────────────────────────────────────────
stage "Team, licence, sharing, tags and creators"
step "Teams: $TEAM_NAME (team $TEAM_ID)."
step "Licence: $LICENCE (Apache License 2.0)."
warn "the team's default licence is CC-BY-4.0: change it, since IRIS is $LICENCE"
step "Workflow type, if it appears here rather than on the last step: $WF_TYPE"
step "Sharing: give $TEAM_NAME manage rights, so the maintainer can fix any team entry."
note "Leave public access as offered; the Publish stage makes it public."
paste_block "Tags" "$TAGS"
step "Creators, in this order:"
say "  1. $OWNER, ORCID $OWNER_ORCID: pick your WorkflowHub profile, and"
say "     check it shows that ORCID (add it to your profile if not)."
say "  2. $ORG_CREATOR: if there's no organisation creator, put it in the"
say "     free-text other-creators field."
step "Click Register."
printf '\n'
until [[ "${WH_ENTRY_URL:-}" =~ ^https://workflowhub\.eu/workflows/[0-9]+ ]]; do
  [[ -n "${WH_ENTRY_URL:-}" ]] && warn "expected https://workflowhub.eu/workflows/<number>"
  ask WH_ENTRY_URL "Paste the new entry's URL:"
  WH_ENTRY_URL="${WH_ENTRY_URL%%\?*}"
done
WH_ENTRY_URL="${WH_ENTRY_URL%/}"
write_env WH_ENTRY_URL "$WH_ENTRY_URL"

# ──────────────────────────────────────────────────────────────────────────
stage "Check the entry, then freeze"
open_url "$WH_ENTRY_URL"
step "Check Title, Description, Creators (both, ORCID on yours), Licence $LICENCE and Team."
step "Fix anything wrong with Actions → Edit Workflow / Manage workflow."
step "Find the version's git details and note which commit it shows."
[[ -n "${WH_IMPORT_COMMIT:-}" ]] && note "It should be ${WH_IMPORT_COMMIT:0:12}… ($BRANCH when you imported)."
step "Actions → Freeze version."
note "Frozen, its files and metadata can't change: that's what the DOI will point at."
pause "Checked and frozen? Press Enter."

# ──────────────────────────────────────────────────────────────────────────
stage "Publish"
printf '  %s%sOne-way door.%s\n' "$BOLD" "$RED" "$RESET"
say "Publish makes the entry public. A public entry with a DOI can't be"
say "withdrawn, so check the metadata once more before going on."
step "Actions → Publish Workflow (sharing: Actions → Manage Workflow)."
printf '\n'
confirm "Publish $SLUG publicly now? This can't be undone once it has a DOI" ||
  stop_here "Stopped before Publish."
pause "Published? Press Enter."

# ──────────────────────────────────────────────────────────────────────────
stage "Generate a DOI"
printf '  %s%sOne-way door.%s\n' "$BOLD" "$RED" "$RESET"
say "A DOI is permanent: DataCite keeps it, and this snapshot's metadata, for good."
step "On the frozen version, Actions → Generate a DOI."
step "It reminds you to review the metadata, then asks you to confirm."
printf '\n'
# Published, the entry is public, so the API shows what the DOI will carry.
say "What the published entry says:"
matches=yes
expect_field title "$TITLE" || matches=no
expect_field licence "$LICENCE" || matches=no
if [[ -n "${WH_IMPORT_COMMIT:-}" ]]; then expect_field commit "$WH_IMPORT_COMMIT" || matches=no; fi
[[ "$matches" == yes ]] || warn "fix it with Actions → Edit Workflow first, or change the value in this script"
printf '\n'
confirm "Generate the DOI for this frozen snapshot now? It can't be undone" ||
  stop_here "Stopped before Generate a DOI."
printf '\n'
# Read from the entry; a pasted DOI covers an API that can't be reached.
WH_DOI=$(wh_read doi)
until [[ "${WH_DOI:-}" =~ ^10\.48546/workflowhub\.workflow\.[0-9]+\.[0-9]+$ ]]; do
  [[ -n "${WH_DOI:-}" ]] && warn "expected a WorkflowHub DOI like 10.48546/workflowhub.workflow.123.1"
  ask WH_DOI "No DOI read from WorkflowHub yet. Paste it, or press Enter to read again:" || true
  WH_DOI="${WH_DOI#https://doi.org/}"
  [[ -n "$WH_DOI" ]] || WH_DOI=$(wh_read doi)
done
ok "DOI: $WH_DOI"
write_env WH_DOI "$WH_DOI"
open_url "https://doi.org/$WH_DOI"
note "It should resolve to the entry; a new DOI can take a few minutes."

if [[ -z "$TICKET" ]]; then finish; exit 0; fi

# ──────────────────────────────────────────────────────────────────────────
stage "Report on #$TICKET"
say "The spec rests on one assumption: that a frozen snapshot records its commit."
WH_COMMIT_SEEN=$(wh_read commit)
[[ -n "$WH_COMMIT_SEEN" ]] && WH_COMMIT_SHOWN=yes && note "WorkflowHub shows $WH_COMMIT_SEEN."
until [[ "${WH_COMMIT_SHOWN:-}" =~ ^(yes|no)$ ]]; do
  ask WH_COMMIT_SHOWN "Does the frozen snapshot show the commit it came from? (yes/no):"
  WH_COMMIT_SHOWN="${WH_COMMIT_SHOWN,,}"
done
write_env WH_COMMIT_SHOWN "$WH_COMMIT_SHOWN"
if [[ "$WH_COMMIT_SHOWN" == yes ]]; then
  [[ -n "$WH_COMMIT_SEEN" ]] || ask WH_COMMIT_SEEN "Paste the commit it shows:"
  write_env WH_COMMIT_SEEN "$WH_COMMIT_SEEN"
  shown="Yes: it shows \`$WH_COMMIT_SEEN\`."
  [[ -n "${WH_IMPORT_COMMIT:-}" ]] && shown+=" \`$BRANCH\` was at \`$WH_IMPORT_COMMIT\` at import."
else
  ask WH_COMMIT_NOTE "Where did you look, and what does it show instead?"
  write_env WH_COMMIT_NOTE "$WH_COMMIT_NOTE"
  shown="No. $WH_COMMIT_NOTE"
  [[ -n "${WH_IMPORT_COMMIT:-}" ]] && shown+=" \`$BRANCH\` was at \`$WH_IMPORT_COMMIT\` at import."
fi
COMMENT="Registered with \`bin/workflowhub-$SLUG\`.

- DOI: https://doi.org/$WH_DOI
- Entry: $WH_ENTRY_URL
- Frozen snapshot shows its commit: $shown"
paste_block "Comment for #$TICKET" "$COMMENT"
printf '\n'
if confirm "Post this on #$TICKET with gh?"; then
  if printf '%s\n' "$COMMENT" | gh issue comment "$TICKET" --repo unsw-restech/iris --body-file - >/dev/null; then
    printf '  %s✓ posted%s on #%s\n' "$GREEN" "$RESET" "$TICKET"
  else
    SKIPPED+=("comment on #$TICKET: gh failed, so paste the comment above")
  fi
else
  SKIPPED+=("comment on #$TICKET: paste the comment above at $REPO_URL/issues/$TICKET")
  pause "Copy the comment, then press Enter."
fi

finish

#!/bin/bash
# Wait for every run of one CI workflow for one pushed commit, `check`
# unless --workflow names another (its file in .github/workflows/ without
# .yml), then show how each ended, with the failed steps' log of any that
# failed. Every run counts, whatever its event: a branch's push run, its
# PR's pull_request run, which alone tests a detached merge commit (#250's
# failure went unseen on three PRs), and main's push run. When the commit
# is origin/main's tip, main's push run must appear, so a branch's finished
# runs can't stand in for it. The runs are listed again after each wait, so
# one that appears late is waited for too; a PR's pull_request run
# appears only once the PR is open, so run it after `gh pr create`. The last line is the verdict,
# "ciwait: <workflow> <sha> passed" or "... failed (run <id>[, <id>])", so
# a tail of the output still carries it. A passing `containers` run also
# prints its "Published <tag> as <registry>@<digest>" lines, the digest to
# pin in lib/katana.sh's digest map.
#
#   bin/ciwait [--repo <clone>] [--workflow <name>] [<commit>]
#   bin/ciwait --pr <n>                           (a pull request's head)
#   bin/ciwait --workflow containers 93d3a39
#   bin/ciwait 93d3a39 --workflow containers      (the same)
#   bin/ciwait --repo ../OpenComposer 7355ac8     (the fork's tests runs)
#
# The commit defaults to HEAD, and the workflow to `check`, or to a repo's
# only workflow when it has no check.yml, as the fork has only tests.yml.
#
# Exits 0 when every run passed, 1 when any failed, or 2 if the commit
# isn't on origin or no run for it (none of main's push, at main's tip)
# appears within two minutes. Runs are matched by headSha. Every gh call
# names unsw-restech/iris (bin/github-repo.sh), not the current directory's
# repo, so a run from the fork's clone waits on iris's CI (#207). --repo
# waits instead on the CI of the clone or worktree <clone> names, reading
# its commit, origin/main and workflows there and its GitHub repo from its
# origin's URL: a session waiting on the fork's CI by hand watched only the
# first run it listed, #250's blind spot (#176's retro).
#
# --pr waits on pull request <n>'s head as GitHub has it, which need not be
# on origin: an author's PR comes from their own fork, and its runs are
# iris's pull_request runs of that head (#201's wait was a loop of its
# own). Once check's runs pass it waits up to two more minutes for the
# `ready` label .github/workflows/ready.yml then adds, which the review
# batch lists by, and the verdict says whether it came: "ciwait: check
# <sha> passed; #<n> is ready", or, exiting 2, "...; #<n> isn't ready after
# 2 min". It takes no commit and no --repo.

usage() { echo "usage: bin/ciwait [--repo <clone> | --pr <n>] [--workflow <name in .github/workflows/>] [<commit>]" >&2; exit 2; }
workflow=""
commit=""
clone=""
pr=""
while [ $# -gt 0 ]; do
    case "$1" in
        --workflow) [ $# -ge 2 ] || usage; workflow="$2"; shift 2 ;;
        --pr) [ $# -ge 2 ] && [ -z "$pr" ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage; pr="$2"; shift 2 ;;
        --repo)
            [ $# -ge 2 ] && [ -z "$clone" ] || usage
            # Resolved before the cd below, so a relative path is the caller's.
            clone="$(git -C "$2" rev-parse --show-toplevel 2> /dev/null)" ||
                { echo "ciwait: $2 isn't in a git repo" >&2; exit 2; }
            shift 2 ;;
        -*) usage ;;
        *) [ -z "$commit" ] || usage; commit="$1"; shift ;;
    esac
done
[ -z "$pr" ] || { [ -z "$commit" ] && [ -z "$clone" ]; } || usage

cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
# shellcheck source=bin/github-repo.sh
. bin/github-repo.sh || exit 2
repo="$IRIS_GITHUB_REPO"
if [ -n "$clone" ]; then
    cd "$clone" || exit 2
    # The URL as configured, before any url.<base>.insteadOf rewrite.
    url="$(git config --get remote.origin.url)"
    repo="$(sed -nE 's#^(https://github\.com/|git@github\.com:)([^/]+/[^/]+)$#\2#p' <<< "${url%.git}")"
    [ -n "$repo" ] || { echo "ciwait: $clone's origin, ${url:-none}, isn't a GitHub repo" >&2; exit 2; }
fi
if [ -z "$workflow" ]; then
    if [ -f .github/workflows/check.yml ]; then
        workflow=check
    else
        set -- .github/workflows/*.yml
        if [ $# != 1 ] || [ ! -f "$1" ]; then
            echo "ciwait: $PWD has no check.yml and not one workflow; name it with --workflow" >&2
            usage
        fi
        workflow="$(basename "$1" .yml)"
    fi
fi

# One of run $1's logs ($2: --log or --log-failed), as plain lines: no job
# and step columns, byte-order mark or timestamp.
clean_log() {
    gh run view "$1" -R "$repo" "$2" | cut -f3- | sed 's/^\xEF\xBB\xBF//; s/^[0-9T:.-]*Z //'
}

[ -f ".github/workflows/$workflow.yml" ] || usage
git fetch -q origin || exit 2
if [ -n "$pr" ]; then
    sha="$(gh pr view "$pr" -R "$repo" --json headRefOid --jq .headRefOid)" && [[ "$sha" =~ ^[0-9a-f]{40}$ ]] ||
        { echo "ciwait: no head for #$pr" >&2; exit 2; }
else
    sha="$(git rev-parse "${commit:-HEAD}")" || exit 2
fi

if [ -z "$pr" ] && [ -z "$(git branch -r --contains "$sha" 2>/dev/null)" ]; then
    echo "ciwait: ${sha:0:7} is not on origin; push it first, or, for a pull request's head on a fork, wait with --pr <n>" >&2
    exit 2
fi

# The workflow's runs of $sha not yet in $seen, one "<id> <event> <branch>"
# line each. --commit filters on GitHub's side, so no run of the commit
# falls outside --limit however many runs other commits have had since.
seen=" "
unseen() {
    gh run list -R "$repo" --workflow "$workflow.yml" --commit "$sha" --limit 20 \
        --json databaseId,headSha,event,headBranch \
        --jq ".[] | select(.headSha == \"$sha\") | \"\(.databaseId) \(.event) \(.headBranch)\"" |
        while read -r id rest; do
            case "$seen" in *" $id "*) ;; *) echo "$id $rest" ;; esac
        done
    return "${PIPESTATUS[0]}"
}

# At origin/main's tip, wait for main's push run itself.
main_tip=""
[ -z "$pr" ] && [ "$sha" = "$(git rev-parse origin/main)" ] && main_tip=1
list="" found=""
for _ in $(seq 24); do
    list="$(unseen)" || exit 2
    if [ -n "$list" ] && { [ -z "$main_tip" ] || grep -q " push main\$" <<< "$list"; }; then found=1; break; fi
    sleep 5
done
if [ -z "$found" ]; then
    if [ -n "$list" ]; then
        echo "ciwait: no $workflow run of main's push for ${sha:0:7} after 2 min" >&2
    else
        echo "ciwait: no $workflow run for ${sha:0:7} after 2 min" >&2
    fi
    exit 2
fi

failed=""
while [ -n "$list" ]; do
    while read -r id event branch; do
        seen="$seen$id "
        echo "== $workflow run $id ($event, $branch) for ${sha:0:7}"
        gh run watch "$id" -R "$repo" --exit-status --interval 15 > /dev/null 2>&1
        rc=$?
        gh run view "$id" -R "$repo"
        if [ $rc -ne 0 ]; then
            clean_log "$id" --log-failed | tail -40
            failed="${failed:+$failed, }$id"
        elif [ "$workflow" = containers ]; then
            # Only a run on main publishes; a branch's run builds and checks.
            clean_log "$id" --log | grep '^Published .* as ' ||
                echo "No Published line: this run published nothing."
        fi
    done <<< "$list"
    # Runs not yet waited for, such as a pull_request run that appeared
    # while the push run was being watched.
    list="$(unseen)" || exit 2
done

if [ -n "$failed" ]; then
    echo "ciwait: $workflow ${sha:0:7} failed (run $failed)"
    exit 1
fi
if [ -n "$pr" ] && [ "$workflow" = check ]; then
    for _ in $(seq 24); do
        labels="$(gh pr view "$pr" -R "$repo" --json labels --jq '.labels[].name')" || exit 2
        if grep -qx ready <<< "$labels"; then
            echo "ciwait: $workflow ${sha:0:7} passed; #$pr is ready"
            exit 0
        fi
        sleep 5
    done
    echo "ciwait: $workflow ${sha:0:7} passed; #$pr isn't ready after 2 min"
    exit 2
fi
echo "ciwait: $workflow ${sha:0:7} passed"

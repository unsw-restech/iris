#!/bin/bash
# Wait for the `check` CI run of one pushed commit, then show how it ended,
# with the failed steps' log if it failed.
#
#   bin/ciwait [<commit>]        (default HEAD)
#
# Exits with the run's result (0 passed, 1 failed), or 2 if the commit isn't
# on origin or no run for it appears within two minutes. The run is matched
# by headSha: the desktop's gh 2.4.0 has no `gh run list --commit`.

cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
sha="$(git rev-parse "${1:-HEAD}")" || exit 2

git fetch -q origin || exit 2
if [ -z "$(git branch -r --contains "$sha" 2>/dev/null)" ]; then
    echo "ciwait: ${sha:0:7} is not on origin; push it first" >&2
    exit 2
fi

id=""
for _ in $(seq 24); do
    id="$(gh run list --workflow check.yml --limit 20 --json databaseId,headSha \
        --jq ".[] | select(.headSha == \"$sha\") | .databaseId" | head -1)" || exit 2
    [ -n "$id" ] && break
    sleep 5
done
[ -n "$id" ] || { echo "ciwait: no check run for ${sha:0:7} after 2 min" >&2; exit 2; }

echo "== check run $id for ${sha:0:7}"
gh run watch "$id" --exit-status --interval 15 > /dev/null 2>&1
status=$?
gh run view "$id"
if [ $status -ne 0 ]; then
    gh run view "$id" --log-failed | cut -f3- | sed 's/^\xEF\xBB\xBF//; s/^[0-9T:.-]*Z //' | tail -40
    status=1
fi
exit $status

#!/bin/bash
# Refuses a commit whose message carries AI attribution, using the
# patterns bin/check applies to main's history (.githooks/attribution-patterns),
# or git's conflict list. bin/check can only see a message once it is
# committed; this catches it first. Turn it on once per clone:
# git config core.hooksPath .githooks

# git commit --no-edit keeps a conflicted merge's "# Conflicts:" list. An
# editor session has the list too, but its cleanup removes it, and git's
# "# Please enter" hint marks that session. So does a cherry-pick's
# --continue, with no hint, so this reads merges alone.
if git rev-parse -q --verify MERGE_HEAD > /dev/null &&
    grep -q '^# Conflicts:' "$1" && ! grep -q '^# Please enter' "$1"; then
    echo "commit-msg: git's conflict list in the message; finish the merge with git commit -m \"<message>\"" >&2
    exit 1
fi

patterns="$(dirname "$0")/attribution-patterns"
# git runs this before cleanup: drop a commit -v diff below the scissors
# line, then comments, as git will.
hits="$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1" | git stripspace --strip-comments |
    grep -i -E -f "$patterns")"
if [ -n "$hits" ]; then
    echo "commit-msg: AI attribution in the message (.githooks/attribution-patterns):" >&2
    echo "$hits" | sed 's/^/  /' >&2
    exit 1
fi

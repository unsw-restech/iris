#!/bin/bash
# Refuses a push to main, the public deploy, of a commit this clone hasn't
# checked as it stands:
#   - a full bin/check must have passed on its tree (bin/check-passed), so
#     a branch merged with a newer main is checked as the commit main
#     becomes, not as each side was before the merge;
#   - if it changes the files bin/katana-test tests (its header lists
#     them), a passing bin/katana-test must have tested them exactly as the
#     commit holds them (bin/katana-test --tested).
# The dev clone pulls main next. Pushes to any other branch go through, so
# CI can run on unchecked work.
#
# IRIS_UNCHECKED=<reason> lets the push through without the first, and
# IRIS_KATANA_UNTESTED=<reason> without the second, naming the reason, for
# a change the IRIS maintainer has agreed to ship that way.
# Turn it on once per clone: git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"
check_passed="$root/bin/check-passed"
katana_test="$root/bin/katana-test"
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha remote_ref remote_sha; do
    [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != "$zero" ] || continue

    if [ -x "$check_passed" ] && ! "$check_passed" "$local_sha"; then
        if [ -n "$IRIS_UNCHECKED" ]; then
            echo "pre-push: ${local_sha:0:7} goes to main without a full bin/check pass: $IRIS_UNCHECKED" >&2
        else
            echo "pre-push: no full bin/check in this clone passed on ${local_sha:0:7}'s files." >&2
            echo "  Run bin/check with that commit checked out (again after merging main), or set IRIS_UNCHECKED=<reason> once the IRIS maintainer agrees." >&2
            status=1
        fi
    fi

    [ -x "$katana_test" ] || continue
    # main's commit as the base: tested files it already holds need no run.
    base=""
    [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null && base="$remote_sha"
    "$katana_test" --tested "$local_sha" ${base:+"$base"}
    case $? in
        0) continue ;;
        2) echo "pre-push: this checkout's bin/katana-test has no --tested; push from a checkout that has it (since 1182a53)." >&2
           status=1; continue ;;
    esac
    if [ -n "$IRIS_KATANA_UNTESTED" ]; then
        echo "pre-push: ${local_sha:0:7} goes to main untested on Katana: $IRIS_KATANA_UNTESTED" >&2
        continue
    fi
    echo "pre-push: ${local_sha:0:7} changes what bin/katana-test tests, and no passing bin/katana-test in this clone tested it." >&2
    echo "  Run bin/katana-test with that commit checked out, or set IRIS_KATANA_UNTESTED=<reason> once the IRIS maintainer agrees." >&2
    status=1
done
exit $status

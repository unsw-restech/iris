! ARES - Quantum ESPRESSO: bulk silicon, self-consistent field
!
! The standard first calculation in plane-wave DFT. Silicon in the
! diamond structure, 2 atoms in the primitive cell, converged in
! seconds. Edit this file to model your own material.
!
! Forces and stress are switched on so the output can be used as the
! starting point for a geometry relaxation (change calculation to
! 'relax' or 'vc-relax').

&CONTROL
  calculation  = 'scf'
  prefix       = 'silicon'
  outdir       = './out'
  pseudo_dir   = './pseudo'
  tprnfor      = .true.        ! print forces on atoms
  tstress      = .true.        ! print the stress tensor
  verbosity    = 'high'
/

&SYSTEM
  ibrav        = 2             ! face-centred cubic
  celldm(1)    = 10.20         ! lattice parameter, bohr (5.40 angstrom)
  nat          = 2             ! atoms in the cell
  ntyp         = 1             ! distinct species
  ecutwfc      = 30.0          ! wavefunction cutoff, Ry - raise to converge
/

&ELECTRONS
  conv_thr     = 1.0d-8        ! SCF convergence threshold, Ry
  mixing_beta  = 0.7
/

ATOMIC_SPECIES
  Si  28.086  Si.pz-vbc.UPF

ATOMIC_POSITIONS alat
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25

K_POINTS automatic
  8 8 8  0 0 0

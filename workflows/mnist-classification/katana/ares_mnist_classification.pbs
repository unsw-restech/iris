#!/bin/bash
#PBS -N ARES_mnist_classification
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /srv/scratch/$USER/ares-mnist-classification/ares_mnist_classification.log

# ═══════════════════════════════════════════════════════════════
#  ARES — MNIST image classification
#  Trains a small CNN on MNIST using Katana's PyTorch module.
#
#  Nothing is installed and nothing large is downloaded: the
#  environment comes from `module load pytorch`, and the dataset
#  is ~11 MB of IDX files. torch is the only dependency — MNIST
#  is parsed with the standard library, so no torchvision needed.
#
#  Run katana/prepare.sh on a login node first if the compute
#  nodes have no outbound internet; it pre-fetches the dataset.
#
#  Output goes to: /srv/scratch/$USER/ares-mnist-classification/
#  Usage log:      /srv/scratch/ares/usage-log/usage.jsonl
# ═══════════════════════════════════════════════════════════════

# ── Parameters (edit if needed) ────────────────────────────────
OUTDIR="/srv/scratch/$USER/ares-mnist-classification"
DATADIR="/srv/scratch/$USER/ares-mnist-classification/data"
PYTORCH_MODULE="pytorch/1.13.1"
EPOCHS=3
BATCH_SIZE=128
LR=0.001
# ───────────────────────────────────────────────────────────────

set -euo pipefail

WORKFLOW="ares-mnist-classification"
VERSION="1.1.0"
STATUS="failed"          # flipped to success at the end; read by the exit trap
COMPUTE="katana"         # upgraded to katana-gpu if a GPU turns out to be visible
RAW_BASE="https://raw.githubusercontent.com/PatrickTung/ares/main/workflows/mnist-classification"

echo "========================================"
echo "  ARES MNIST classification — Katana"
echo "========================================"
echo ""
echo "Timestamp : $(date)"
echo "User      : $USER"
echo "Job ID    : ${PBS_JOBID:-<interactive>}"
echo "Hostname  : $(hostname)"
echo "Work dir  : ${PBS_O_WORKDIR:-$PWD}"
echo ""

mkdir -p "$OUTDIR" "$DATADIR"

# ── Usage logging on exit, success or failure ───────────────────
log_usage() {
    local logdir="/srv/scratch/ares/usage-log"
    local logfile="$logdir/usage.jsonl"
    if [ -d "$logdir" ]; then
        echo "{\"workflow\":\"$WORKFLOW\",\"version\":\"$VERSION\",\"user\":\"$USER\",\"job_id\":\"${PBS_JOBID:-none}\",\"status\":\"$STATUS\",\"compute\":\"$COMPUTE\",\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" >> "$logfile"
        echo "Usage logged to: $logfile"
    else
        echo "Warning: usage log directory not found at $logdir — skipping log."
        echo "(Ask ResTech to create /srv/scratch/ares/usage-log/)"
    fi
}
trap log_usage EXIT

# ── GPU detection ───────────────────────────────────────────────
if command -v nvidia-smi > /dev/null 2>&1 && nvidia-smi > /dev/null 2>&1; then
    COMPUTE="katana-gpu"
    echo "GPU detected:"
    nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
else
    echo "No GPU visible — the job will train on CPU (slower, but it will finish)."
fi
echo ""

# ── Environment: Katana modules ─────────────────────────────────
# `module` is a shell function, so it may not exist in a non-interactive
# shell. Source the init script if it is missing.
if ! type module > /dev/null 2>&1; then
    for init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash; do
        # shellcheck disable=SC1090
        [ -f "$init" ] && . "$init" && break
    done
fi
if ! type module > /dev/null 2>&1; then
    echo "ERROR: the 'module' command is not available on this node."
    echo "Ask ResTech how to initialise Environment Modules in a batch job."
    exit 1
fi

# Module scripts often reference unset variables, which trips `set -u`.
set +u
module purge
module load "$PYTORCH_MODULE"
set -u

echo "Loaded modules:"
module list 2>&1 | sed 's/^/  /'
echo ""

if ! python3 -c "import torch" > /dev/null 2>&1; then
    echo "ERROR: '$PYTORCH_MODULE' loaded but 'import torch' failed."
    echo ""
    echo "Check what is actually available:"
    echo "    module avail pytorch"
    echo "then set PYTORCH_MODULE at the top of this script to a version that exists."
    exit 1
fi

python3 - <<'PY'
import torch
print(f"PyTorch      : {torch.__version__}")
print(f"CUDA build   : {torch.version.cuda or 'no (CPU-only build)'}")
print(f"CUDA visible : {torch.cuda.is_available()}")
PY
echo ""

# ── Training script ─────────────────────────────────────────────
TRAIN_SCRIPT=""
for candidate in \
    "${PBS_O_WORKDIR:-$PWD}/train_mnist.py" \
    "${PBS_O_WORKDIR:-$PWD}/../src/train_mnist.py" \
    "${PBS_O_WORKDIR:-$PWD}/src/train_mnist.py" \
    "$OUTDIR/train_mnist.py"
do
    if [ -f "$candidate" ]; then
        TRAIN_SCRIPT="$candidate"
        break
    fi
done

if [ -z "$TRAIN_SCRIPT" ]; then
    echo "train_mnist.py not found nearby — fetching it from GitHub."
    if curl -fsSL "$RAW_BASE/src/train_mnist.py" -o "$OUTDIR/train_mnist.py"; then
        TRAIN_SCRIPT="$OUTDIR/train_mnist.py"
    else
        echo "ERROR: could not find or download train_mnist.py."
        echo "Put it next to this script, or in ../src/, or download it manually:"
        echo "  curl -O $RAW_BASE/src/train_mnist.py"
        exit 1
    fi
fi
echo "Training script: $TRAIN_SCRIPT"
echo ""

# ── Run ─────────────────────────────────────────────────────────
echo "----------------------------------------"
python3 "$TRAIN_SCRIPT" \
    --data-dir "$DATADIR" \
    --outdir "$OUTDIR" \
    --epochs "$EPOCHS" \
    --batch-size "$BATCH_SIZE" \
    --lr "$LR"
echo "----------------------------------------"
echo ""

STATUS="success"
echo "Results in: $OUTDIR"
echo ""
echo "========================================"
echo "  ARES MNIST classification — Complete"
echo "========================================"

---
form:

  # ── Data ──────────────────────────────────────────────────────
  dataset:
    widget: path
    label: "Dataset folder"
    required: true
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "The folder you copied to your scratch, holding images/ and train/. Each run writes a run directory into its runs/ folder."

  # ── Tracking ──────────────────────────────────────────────────
<%-
  # The command a researcher types to compare runs, which this help gives.
  # Rendered from the system clone, it is the short form that `module load
  # iris` puts on the PATH (ADR-0003). Rendered from any other clone, such
  # as the dev clone, it is that clone's bin/ in full, so a dev run is
  # compared with the code that ran it. lib/iris-job.sh makes the same
  # choice for the view and compare commands in the job output.
  if @apps_dir && File.expand_path(@apps_dir) == "/srv/scratch/katana_ai/iris/code/workflows"
    load_iris, iris_compare = "module load iris", "iris-compare"
  else
    load_iris, iris_compare = nil, File.expand_path(File.join(@apps_dir.to_s, "..", "bin", "iris-compare"))
  end
-%>
  experiment:
    widget: text
    label: "Experiment name"
    value: "microscopy-cell-segmentation"
    required: true
    help: "Groups the runs you want to compare, such as runs on one dataset with different settings. Every run is recorded in your tracking store, /srv/scratch/<%= ENV['USER'] %>/iris/tracking.db: to compare runs, run <%= [load_iris, iris_compare].compact.join(" and then ") %> in a terminal in a Virtual Desktop."

  # ── Training ──────────────────────────────────────────────────
  # The epochs, memory and walltime defaults are provisional, the reference
  # workflow's, until #235's timing run measures them on the prepared dataset.
  epochs:
    widget: number
    label: "Epochs"
    value: 50
    min: 1
    max: 500
    step: 1
    help: "Passes over the training patches. Raise it if Dice is still rising at the end."

  patch_size:
    widget: select
    label: "Patch size (pixels)"
    value: "256"
    options:
      - [ "128", "128" ]
      - [ "256", "256" ]
      - [ "512", "512" ]
    help: "Images are cut into square patches on a non-overlapping grid. Larger patches give more context per patch but fewer patches."

  learning_rate:
    widget: number
    label: "Learning rate"
    value: 0.001
    min: 0.00001
    max: 0.1
    step: 0.00001
    help: "Adam learning rate."

  val_percent:
    widget: number
    label: "Validation patches (%)"
    value: 20
    min: 5
    max: 50
    step: 5
    help: "Share of labelled patches held out to score the model (per-class Dice and IoU). The split is random; its seed is recorded with the run."

  # ── Resources ─────────────────────────────────────────────────
  ngpus:
    widget: number
    label: "GPUs (0 = CPU only)"
    value: 1
    min: 0
    max: 1
    step: 1
    help: "Any GPU type on Katana works. Use 0 only for a small test: CPU is far slower."

  ncpus:
    widget: number
    label: "CPU cores (1 - 16)"
    value: 8
    min: 1
    max: 16
    step: 1
    help: "Used for reading the images and preparing patches."

  mem:
    widget: select
    label: "Memory"
    value: "16 GB"
    options:
      - [ "16 GB",  "16gb"  ]
      - [ "32 GB",  "32gb"  ]
      - [ "64 GB",  "64gb"  ]
      - [ "124 GB", "124gb" ]
    help: "Raise it if the job runs out of memory."

  time:
    widget: number
    label:   [ "Walltime hours (0 - 200)", "Walltime minutes (0 - 59)" ]
    size:    2
    value:   [ 2, 0 ]
    min:     [ 0, 0 ]
    max:     [ 200, 59 ]
    step:    [ 1, 1 ]
    help: "Covers training and segmenting the image set. Jobs up to 12 hours can run on any node."

  # ── Advanced options ──────────────────────────────────────────
  show_advanced_option:
    widget: checkbox
    options:
      - [ "Show advanced options", "", show-batch_size, show-seed, show-job_name, show-mail_events ]

  batch_size:
    widget: select
    label: "Batch size"
    indent: 1
    value: "16"
    options:
      - [ "4",  "4"  ]
      - [ "8",  "8"  ]
      - [ "16", "16" ]
      - [ "32", "32" ]
    help: "Patches per training step. Lower it if the job runs out of GPU memory."

  seed:
    widget: text
    label: "Random seed"
    indent: 1
    value: ""
    help: "Leave blank for a new random split each run; the seed used is recorded in params.json. Set it to repeat a split exactly."

  job_name:
    widget: text
    label: "PBS Job name"
    indent: 1
    value: "iris_microscopy_cell_segmentation"
    help: "No spaces or special characters. Only for your own reference in the queue."

  # A select, not checkboxes: OpenComposer drops every script line naming a
  # checkbox with nothing ticked, #PBS -m among them (#184), and here the
  # recorded fields too. Each value is a valid #PBS -m; n is no mail.
  mail_events:
    label: "Mail events"
    widget: select
    indent: 1
    value: "When the job ends or ends abnormally"
    options:
      - [ "When the job ends or ends abnormally",         "ae"  ]
      - [ "When the job starts, ends or ends abnormally", "abe" ]
      - [ "Only when the job ends abnormally",            "a"   ]
      - [ "Never",                                        "n"   ]

# The form finds its own clone, so jobs run that clone's code. OpenComposer
# re-reads this file on submit with @apps_dir unset, but it submits the
# script rendered here, so the fallback never reaches a job.
# PBS writes the job output beside the run directory, as
# runs/<full job ID>.OU (runs/9544829.kman.restech.unsw.edu.au.OU).
#
# The script carries the entry script, read here at render time, so a
# researcher can edit it for one run; the job writes it into the run
# directory as run.py and runs it from there, while the library's job side
# runs from this workflow's own copy in lib/, which bin/libcopy makes, and
# stays out of the pane (ADR-0006). It must hold no OpenComposer field or ERB tag, which bin/check
# enforces. COMMIT is the clone's commit at render time, the commit the
# embedded code is from. Before Python runs run.py, iris_record_code records
# the run's code: COMMIT, a warning if the clone has moved since, and
# run.py's diff against the entry script at COMMIT, which it prints.
# IRIS_ENV_VERSION pins the environment version the workflow was proved in
# (envs/README.md), and iris_container runs Python in its container.
<% code = @apps_dir ? File.expand_path(File.join(@apps_dir, @OC_DIR_NAME)) : "" %>
<%- entry_script = "src/run.py" -%>
<%- entry_code = code.empty? ? "" : File.read(File.join(code, entry_script)).gsub(/^(?=.)/, "  ") -%>
<%- commit = code.empty? ? "" : (IO.popen(["git", "-C", code, "rev-parse", "HEAD"], err: File::NULL, &:read).strip rescue "") -%>
# The editable region (#161, #171): on the IRIS fork only the lines
# strictly between these two script: lines, the run.py heredoc's body, can
# be edited; both marker lines and everything else are locked. Each names
# one whole line, compared with its indent stripped, and the script is
# submitted unchanged. Stock OpenComposer ignores the key.
editable_region:
  begin: "cat > \"$RUN_DIR/run.py\" <<'IRIS_RUN_PY_END'"
  end: "IRIS_RUN_PY_END"
script: |
  #!/bin/bash
  #PBS -N #{job_name}
  #PBS -A iris-microscopy-cell-segmentation
  #PBS -l select=1:ncpus=#{ncpus}:mem=#{mem}:ngpus=#{ngpus}
  #PBS -l walltime=#{time_1}:#{zeropadding(time_2, 2)}:00
  #PBS -M <%= ENV['USER'] %>@ad.unsw.edu.au
  #PBS -m #{mail_events}
  #PBS -j oe
  #PBS -o #{dataset}/runs/

  CODE="<%= code %>"
  COMMIT="<%= commit %>"
  [ -n "$CODE" ] || { echo "ERROR: the form could not locate its IRIS clone."; exit 1; }
  IRIS_ENV_VERSION=microct/1
  DATASET="#{dataset}"
  RUN_DIR="${DATASET%/}/runs/${PBS_JOBID%%.*}"

  set -eo pipefail
  source "$CODE/lib/iris-job.sh"

  # Edit the workflow code below
  cat > "$RUN_DIR/run.py" <<'IRIS_RUN_PY_END'
<%= entry_code -%>
  IRIS_RUN_PY_END
  iris_record_code <%= entry_script %>

  iris_container python "$RUN_DIR/run.py" \
    --dataset "$DATASET" --run-dir "$RUN_DIR" \
    --experiment "#{:experiment}" \
    --epochs #{epochs} --patch-size #{patch_size} --lr #{learning_rate} \
    --val-percent #{val_percent} --batch-size #{batch_size} --seed "#{:seed}" \
    --field ngpus=#{ngpus} --field ncpus=#{ncpus} --field mem=#{mem} \
    --field walltime=#{time_1}:#{zeropadding(time_2, 2)}:00 \
    --field "job_name=#{:job_name}" \
    --field "mail_events=#{:mail_events}"

  iris_done

check: |
  scratch = "/srv/scratch/" + ENV['USER']
  ds = File.expand_path(@dataset.to_s.strip)
  oc_assert(ds == scratch || ds.start_with?(scratch + "/"), "The dataset folder must be inside your scratch, " + scratch + ".")
  oc_assert(ds !~ /\s/, "The dataset folder's path cannot contain spaces: rename " + ds + ".")
  oc_assert(File.directory?(ds), "No folder at " + ds + ".")
  files_in = lambda { |dir| Dir.children(dir).select { |f| File.file?(File.join(dir, f)) }.sort }
  # The job reads every file as a TIFF, whatever its name, so each must
  # start as a TIFF or BigTIFF does, in either byte order.
  tiff_starts = ["II*\x00", "MM\x00*", "II+\x00", "MM\x00+"]
  refuse_non_tiffs = lambda do |dir, names|
    odd = names.reject { |f| tiff_starts.include?(File.binread(File.join(dir, f), 4).to_s) }
    oc_assert(odd.empty?, "These files in " + dir + " are not TIFFs: " + odd.first(5).join(", ") + ". Every image and label must be a single-page, single-channel 2D TIFF.")
  end
  image_set = File.join(ds, "images")
  set_names = File.directory?(image_set) ? files_in.call(image_set) : []
  oc_assert(!set_names.empty?, "No image set in " + image_set + ". Copy the images to segment there.")
  refuse_non_tiffs.call(image_set, set_names)
  imgs = File.join(ds, "train", "images")
  labs = File.join(ds, "train", "labels")
  oc_assert(File.directory?(imgs) && File.directory?(labs), "Missing train/images or train/labels in " + ds + ".")
  image_names = files_in.call(imgs)
  label_names = files_in.call(labs)
  oc_assert(!image_names.empty?, "No training images in " + imgs + ".")
  oc_assert(image_names == label_names, "train/images and train/labels hold different file names: " + ((image_names - label_names) + (label_names - image_names)).first(5).join(", "))
  refuse_non_tiffs.call(imgs, image_names)
  refuse_non_tiffs.call(labs, label_names)
  oc_assert(@experiment.to_s =~ /\A[A-Za-z0-9._-]+( [A-Za-z0-9._-]+)*\z/, "The experiment name can hold only letters, digits, spaces, dots, dashes and underscores.")
  oc_assert(@job_name.to_s =~ /\A[A-Za-z0-9._-]+\z/, "The job name can hold only letters, digits, dots, dashes and underscores.")
  oc_assert(@time_1.to_i > 0 || @time_2.to_i > 0, "Walltime cannot be zero.")

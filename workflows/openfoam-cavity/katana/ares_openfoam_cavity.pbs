#!/bin/bash
#PBS -N ARES_openfoam_cavity
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /srv/scratch/$USER/ares-openfoam-cavity/ares_openfoam_cavity.log

# ═══════════════════════════════════════════════════════════════
#  ARES — CFD: lid-driven cavity (OpenFOAM)
#  Solves the classic lid-driven cavity flow with icoFoam.
#
#  The case is copied from OpenFOAM's own bundled tutorials, so
#  no input data is needed and the run is fully self-contained.
#
#  Nothing is installed: the environment comes from `module load`.
#
#  Output goes to: /srv/scratch/$USER/ares-openfoam-cavity/
#  Usage log:      /srv/scratch/ares/usage-log/usage.jsonl
# ═══════════════════════════════════════════════════════════════

# ── Parameters (edit if needed) ────────────────────────────────
OUTDIR="/srv/scratch/$USER/ares-openfoam-cavity"
CASE="incompressible/icoFoam/cavity/cavity"
SOLVER="icoFoam"
OPENFOAM_MODULE="openfoam/2506"
# ───────────────────────────────────────────────────────────────

set -euo pipefail

WORKFLOW="ares-openfoam-cavity"
VERSION="1.0.0"
STATUS="failed"
COMPUTE="katana"

echo "========================================"
echo "  ARES OpenFOAM cavity — Katana"
echo "========================================"
echo ""
echo "Timestamp : $(date)"
echo "User      : $USER"
echo "Job ID    : ${PBS_JOBID:-<interactive>}"
echo "Hostname  : $(hostname)"
echo ""

mkdir -p "$OUTDIR"

log_usage() {
    local logdir="/srv/scratch/ares/usage-log"
    if [ -d "$logdir" ]; then
        echo "{\"workflow\":\"$WORKFLOW\",\"version\":\"$VERSION\",\"user\":\"$USER\",\"job_id\":\"${PBS_JOBID:-none}\",\"status\":\"$STATUS\",\"compute\":\"$COMPUTE\",\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" >> "$logdir/usage.jsonl"
        echo "Usage logged to: $logdir/usage.jsonl"
    else
        echo "Warning: usage log directory not found at $logdir — skipping log."
    fi
}
trap log_usage EXIT

# ── Environment ─────────────────────────────────────────────────
if ! type module > /dev/null 2>&1; then
    for init in /etc/profile.d/modules.sh /usr/share/Modules/init/bash; do
        # shellcheck disable=SC1090
        [ -f "$init" ] && . "$init" && break
    done
fi
if ! type module > /dev/null 2>&1; then
    echo "ERROR: the 'module' command is not available on this node."
    exit 1
fi

# OpenFOAM's own environment script is not `set -u` clean either, so keep
# nounset off across both the module load and the sourcing it triggers.
set +u
module purge
module load "$OPENFOAM_MODULE"
set -u

if ! command -v "$SOLVER" > /dev/null 2>&1; then
    echo "ERROR: '$OPENFOAM_MODULE' loaded but '$SOLVER' is not on PATH."
    echo "Run 'module avail openfoam' and update OPENFOAM_MODULE at the top."
    exit 1
fi
echo "Loaded modules:"
module list 2>&1 | sed 's/^/  /'
echo "Solver: $(command -v "$SOLVER")"
echo ""

# ── Locate the bundled tutorial ─────────────────────────────────
# $FOAM_TUTORIALS is set by the OpenFOAM environment; fall back to the
# usual layout under $WM_PROJECT_DIR if it isn't.
TUTORIAL_ROOT="${FOAM_TUTORIALS:-${WM_PROJECT_DIR:-}/tutorials}"
SRC="$TUTORIAL_ROOT/$CASE"

if [ ! -d "$SRC" ]; then
    echo "ERROR: tutorial case not found at $SRC"
    echo "FOAM_TUTORIALS=${FOAM_TUTORIALS:-<unset>}"
    echo "Check the case path for this OpenFOAM version and update CASE."
    exit 1
fi

RUNDIR="$OUTDIR/$(basename "$CASE")"
rm -rf "$RUNDIR"
cp -r "$SRC" "$RUNDIR"
cd "$RUNDIR"
echo "Case: $SRC"
echo "Run directory: $RUNDIR"
echo ""

# ── Mesh and solve ──────────────────────────────────────────────
echo "----------------------------------------"
echo "[1/2] blockMesh"
blockMesh 2>&1 | tail -20
echo ""
echo "[2/2] $SOLVER"
"$SOLVER" 2>&1 | tail -30
echo "----------------------------------------"
echo ""

# Time directories written by the solver are the result.
echo "Time directories produced:"
ls -d [0-9]* 2>/dev/null | sort -g | sed 's/^/  /' || echo "  (none)"
echo ""

STATUS="success"
echo "Results in: $RUNDIR"
echo "Open with ParaView (module load paraview) or run foamToVTK for other tools."
echo ""
echo "========================================"
echo "  ARES OpenFOAM cavity — Complete"
echo "========================================"

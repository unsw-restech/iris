---
form:

  # ── Data ──────────────────────────────────────────────────────
  dataset:
    widget: path
    label: "Dataset folder"
    required: true
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "The folder you copied to your scratch, holding volume/ and train/. Results go into its runs/ folder."

  # ── Tracking ──────────────────────────────────────────────────
<%-
  # The commands a researcher types to view and compare runs, which this
  # help and the job output give. Rendered from the system clone, they are
  # the short forms that `module load iris` puts on the PATH (ADR-0003).
  # Rendered from any other clone, such as the dev clone, they are that
  # clone's bin/ in full, so a dev run is viewed with the code that ran it.
  if @apps_dir && File.expand_path(@apps_dir) == "/srv/scratch/katana_ai/iris/code/workflows"
    load_iris, iris_view, iris_compare = "module load iris", "iris-view", "iris-compare"
  else
    bin = File.expand_path(File.join(@apps_dir.to_s, "..", "bin"))
    load_iris, iris_view, iris_compare = nil, File.join(bin, "iris-view"), File.join(bin, "iris-compare")
  end
-%>
  experiment:
    widget: text
    label: "Experiment name"
    value: "microct-2d-segmentation"
    required: true
    help: "Groups the runs you want to compare, such as runs on one dataset with different settings. Every run is recorded in your tracking store, /srv/scratch/<%= ENV['USER'] %>/iris/tracking.db: to compare runs, run <%= [load_iris, iris_compare].compact.join(" and then ") %> in a terminal in a Virtual Desktop."

  # ── Training ──────────────────────────────────────────────────
  epochs:
    widget: number
    label: "Epochs"
    value: 50
    min: 1
    max: 500
    step: 1
    help: "Passes over the training patches. With 5-30 labelled slices, more epochs are cheap."

  patch_size:
    widget: select
    label: "Patch size (pixels)"
    value: "256"
    options:
      - [ "128", "128" ]
      - [ "256", "256" ]
      - [ "512", "512" ]
    help: "Slices are cut into square patches on a non-overlapping grid. Larger patches give more context per patch but fewer patches."

  learning_rate:
    widget: number
    label: "Learning rate"
    value: 0.001
    min: 0.00001
    max: 0.1
    step: 0.00001
    help: "Adam learning rate."

  val_percent:
    widget: number
    label: "Validation patches (%)"
    value: 20
    min: 5
    max: 50
    step: 5
    help: "Share of labelled patches held out to score the model (per-class Dice and IoU). The split is random; its seed is recorded with the run."

  # ── Resources ─────────────────────────────────────────────────
  ngpus:
    widget: number
    label: "GPUs (0 = CPU only)"
    value: 1
    min: 0
    max: 1
    step: 1
    help: "Any GPU type on Katana works. Use 0 only for a small test: CPU is far slower on a full volume."

  ncpus:
    widget: number
    label: "CPU cores (1 - 16)"
    value: 8
    min: 1
    max: 16
    step: 1
    help: "Used for reading the volume and preparing patches."

  mem:
    widget: select
    label: "Memory"
    value: "16gb"
    options:
      - [ "16 GB",  "16gb"  ]
      - [ "32 GB",  "32gb"  ]
      - [ "64 GB",  "64gb"  ]
      - [ "124 GB", "124gb" ]
    help: "16 GB covers a 2520 x 2520 x 1280 scan, which used 6 GB. Larger slices may need more."

  time:
    widget: number
    label:   [ "Walltime hours (0 - 200)", "Walltime minutes (0 - 59)" ]
    size:    2
    value:   [ 2, 0 ]
    min:     [ 0, 0 ]
    max:     [ 200, 59 ]
    step:    [ 1, 1 ]
    help: "Training plus segmenting the whole volume: a 16 GB volume took 16 minutes on a V100 at the defaults. Jobs up to 12 hours can run on any node."

  # ── Advanced options ──────────────────────────────────────────
  show_advanced_option:
    widget: checkbox
    options:
      - [ "Show advanced options", "", show-batch_size, show-seed, show-job_name, show-mail_events ]

  batch_size:
    widget: select
    label: "Batch size"
    indent: 1
    value: "16"
    options:
      - [ "4",  "4"  ]
      - [ "8",  "8"  ]
      - [ "16", "16" ]
      - [ "32", "32" ]
    help: "Patches per training step. Lower it if the job runs out of GPU memory."

  seed:
    widget: text
    label: "Random seed"
    indent: 1
    value: ""
    help: "Leave blank for a new random split each run; the seed used is recorded in params.json. Set it to repeat a split exactly."

  job_name:
    widget: text
    label: "PBS Job name"
    indent: 1
    value: "iris_microct"
    help: "No spaces or special characters. Only for your own reference in the queue."

  mail_events:
    label: "Mail events"
    widget: checkbox
    direction: horizontal
    separator: ""
    indent: 1
    value: [ "Send email when a job ends abnormally", "Send email when a job ends" ]
    options:
      - [ "Send email when a job ends abnormally", "a" ]
      - [ "Send email when a job starts",          "b" ]
      - [ "Send email when a job ends",            "e" ]

# The form finds its own clone, so jobs run that clone's code. OpenComposer
# re-reads this file on submit with @apps_dir unset, but it submits the
# script rendered here, so the fallback never reaches a job.
# PBS writes the job output beside the run directory, as
# runs/<full job ID>.OU (runs/9544829.kman.restech.unsw.edu.au.OU).
#
# The script carries the entry script, read here at render time, so a
# researcher can edit it for one run; the job writes it into the run
# directory as run.py and runs it from there, while lib/ stays in the clone
# (ADR-0006). It must hold no OpenComposer field or ERB tag, which bin/check
# enforces. COMMIT is
# the clone's commit at render time, the commit the embedded code is from:
# the job records it in commit.txt, and warns if the clone has moved since.
<% code = @apps_dir ? File.expand_path(File.join(@apps_dir, @OC_DIR_NAME)) : "" %>
<%- entry_script = "src/run.py" -%>
<%- entry_code = code.empty? ? "" : File.read(File.join(code, entry_script)).gsub(/^(?=.)/, "  ") -%>
<%- commit = code.empty? ? "" : (IO.popen(["git", "-C", code, "rev-parse", "HEAD"], err: File::NULL, &:read).strip rescue "") -%>
script: |
  #!/bin/bash
  #PBS -N #{job_name}
  #PBS -A iris-microct-2d-segmentation
  #PBS -l select=1:ncpus=#{ncpus}:mem=#{mem}:ngpus=#{ngpus}
  #PBS -l walltime=#{time_1}:#{zeropadding(time_2, 2)}:00
  #PBS -M <%= ENV['USER'] %>@ad.unsw.edu.au
  #PBS -m #{mail_events}
  #PBS -j oe
  #PBS -o #{dataset}/runs/

  CODE="<%= code %>"
  COMMIT="<%= commit %>"
  [ -n "$CODE" ] || { echo "ERROR: the form could not locate its IRIS clone."; exit 1; }
  ENV_DIR=/srv/scratch/katana_ai/iris/envs/imaging/1
  DATASET="#{dataset}"
  RUN_DIR="${DATASET%/}/runs/${PBS_JOBID%%.*}"

  set -eo pipefail
  source "$CODE/../../lib/iris-job.sh"

  # ----------------------------------------------------------------------
  # Workflow code: edit below. Set the form fields first; changing a field afterwards discards these edits.
  # ----------------------------------------------------------------------
  cat > "$RUN_DIR/run.py" <<'IRIS_RUN_PY_END'
<%= entry_code -%>
  IRIS_RUN_PY_END

  python "$RUN_DIR/run.py" \
    --dataset "$DATASET" --run-dir "$RUN_DIR" \
    --experiment "#{:experiment}" \
    --epochs #{epochs} --patch-size #{patch_size} --lr #{learning_rate} \
    --val-percent #{val_percent} --batch-size #{batch_size} --seed "#{:seed}" \
    --field ngpus=#{ngpus} --field ncpus=#{ncpus} --field mem=#{mem} \
    --field walltime=#{time_1}:#{zeropadding(time_2, 2)}:00 \
    --field "job_name=#{:job_name}" --field "mail_events=#{:mail_events}"

  iris_done

check: |
  scratch = "/srv/scratch/" + ENV['USER']
  ds = File.expand_path(@dataset.to_s.strip)
  oc_assert(ds == scratch || ds.start_with?(scratch + "/"), "The dataset folder must be inside your scratch, " + scratch + ".")
  oc_assert(ds !~ /\s/, "The dataset folder's path cannot contain spaces: rename " + ds + ".")
  oc_assert(File.directory?(ds), "No folder at " + ds + ".")
  oc_assert(!Dir.glob(File.join(ds, "volume", "*.nc")).empty?, "No .nc files in " + ds + "/volume. Copy the scan's blocks there.")
  imgs = File.join(ds, "train", "images")
  labs = File.join(ds, "train", "labels")
  oc_assert(File.directory?(imgs) && File.directory?(labs), "Missing train/images or train/labels in " + ds + ".")
  image_names = Dir.children(imgs).select { |f| File.file?(File.join(imgs, f)) }.sort
  label_names = Dir.children(labs).select { |f| File.file?(File.join(labs, f)) }.sort
  oc_assert(!image_names.empty?, "No training images in " + imgs + ".")
  oc_assert(image_names == label_names, "train/images and train/labels hold different file names: " + ((image_names - label_names) + (label_names - image_names)).first(5).join(", "))
  oc_assert(@experiment.to_s =~ /\A[A-Za-z0-9._-]+( [A-Za-z0-9._-]+)*\z/, "The experiment name can hold only letters, digits, spaces, dots, dashes and underscores.")
  oc_assert(@job_name.to_s =~ /\A[A-Za-z0-9._-]+\z/, "The job name can hold only letters, digits, dots, dashes and underscores.")
  oc_assert(@time_1.to_i > 0 || @time_2.to_i > 0, "Walltime cannot be zero.")

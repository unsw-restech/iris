#!/bin/bash
#PBS -N iris_compare
#PBS -A iris-microct-2d-segmentation
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=0:25:00
#PBS -j oe
# iris-compare end to end. A fresh store is imported once with an empty run
# index, then RUN (a finished run's run-index pointer) lands in the index,
# and bin/iris-compare runs in the foreground as in a terminal while a
# background probe checks it: the UI lists the run through its REST API,
# listens on 127.0.0.1 only, and closes its port on Ctrl+C. The probe also
# times mlflow ui's start-up. Whole job: 54 s (job 9571403).
#
#   qsub -m abe -v T=/srv/scratch/$USER/iris-test-<n>,RUN=<home>/run-index/<job number>,PYTHONUNBUFFERED=1 compare.pbs
#
# T holds the copy of the tree in T/iris (docs/agents/katana-test-run.md);
# the store goes in T/home-compare, which must not exist yet.
: "${T:?pass T=<scratch test folder> with qsub -v}" "${RUN:?pass RUN=<run-index pointer> with qsub -v}"
ENV_DIR="${ENV_DIR:-/srv/scratch/katana_ai/iris/envs/imaging/1}"
export IRIS_HOME=$T/home-compare PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1
[ -e "$IRIS_HOME" ] && { echo "$IRIS_HOME exists: the store must be fresh"; exit 1; }
cd "$T" || exit 1
unset DISPLAY
ts() { date +%T; }
echo "$(ts) host $(hostname); firefox on this node: $(command -v firefox || echo none)"
time timeout -s ABRT 300 "$T/iris/bin/iris-import"; echo "$(ts) iris-import exit $?"
mkdir -p "$IRIS_HOME/run-index"
cp "$RUN" "$IRIS_HOME/run-index/"
echo "$(ts) indexed $(basename "$RUN") after the last import"

probe() {
    local url="" t0="" pid port addr
    for _ in $(seq 600); do
        [ -z "$t0" ] && [ -e "$IRIS_HOME/ui.log" ] && t0=$(date +%s)
        url=$(grep -o "http://127.0.0.1:[0-9]*" compare.out | head -1)
        [ -n "$url" ] && break
        sleep 1
    done
    pid=$(pgrep -u "$USER" -f "python -u -m iris.compare")
    if [ -z "$url" ]; then echo "$(ts) PROBE: no URL after 600 s"; kill -INT "$pid"; return; fi
    echo "$(ts) PROBE: UI up at $url, $(( $(date +%s) - t0 )) s after ui.log appeared (mlflow ui start-up, to 1 s)"
    port=${url##*:}
    echo "== sockets on port $port"; ss -ltn "sport = :$port"
    echo "== runs the UI shows"
    MLFLOW_DISABLE_AGENT_HINT=1 "$ENV_DIR/bin/python" - "$url" <<'PY'
import sys
from mlflow import MlflowClient
c = MlflowClient(sys.argv[1])
for e in c.search_experiments():
    for r in c.search_runs([e.experiment_id]):
        print(" ", e.name, r.info.run_name, r.info.status, r.data.tags.get("iris_import"))
PY
    addr=$(hostname -i | awk '{print $1}')
    if timeout 5 bash -c "echo > /dev/tcp/$addr/$port" 2>/dev/null; then
        echo "$addr:$port REACHABLE (bad)"
    else
        echo "$addr:$port refused (good)"
    fi
    echo "$(ts) PROBE: Ctrl+C to $pid"; kill -INT "$pid"
    sleep 10
    if ss -ltn "sport = :$port" | tail -n +2 | grep -q .; then
        echo "still listening (bad)"
    else
        echo "port $port closed after Ctrl+C"
    fi
}
. /etc/profile.d/modules.sh; module load python/3.13.2
: > compare.out
probe &
echo "$(ts) starting iris-compare"
"$T/iris/bin/iris-compare" > compare.out 2>&1
echo "$(ts) iris-compare exit $?"
wait
echo "== iris-compare said"; cat compare.out
echo "== ui.log timing"; grep -E "Uvicorn running|GET /health" "$IRIS_HOME/ui.log" | head -2

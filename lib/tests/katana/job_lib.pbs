#!/bin/bash
#PBS -N iris_job_lib
#PBS -A iris-microct-2d-segmentation
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=0:10:00
#PBS -j oe
# test_job_lib needs Katana's modules. T is the scratch test folder holding
# the copy of the tree in T/iris (docs/agents/katana-test-run.md). 12 tests
# took 4 s (job 9654477). bin/katana-test submits it once; by hand:
#
#   qsub -m abe -v T=/srv/scratch/$USER/iris-test-<n>,PYTHONUNBUFFERED=1 job_lib.pbs
#
# The environment and Python module are the tree's own, from its
# lib/katana.sh, so an environment bump is tested on the version the form pins.
: "${T:?pass T=<scratch test folder> with qsub -v}"
. "$T/iris/lib/katana.sh" || exit 1
ENV_DIR="${ENV_DIR:-$IRIS_ENV_DIR}"
. /etc/profile.d/modules.sh; module load "$IRIS_PYTHON_MODULE"
echo "host $(hostname) $(date +%T)"
cd "$T/iris/lib/tests" || exit 1
"$ENV_DIR/bin/python" -X faulthandler -m unittest -v test_job_lib 2>&1
s=$?
echo "exit $s $(date +%T)"
exit $s

#!/bin/bash
#PBS -N iris_canary
#PBS -A iris-tests
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=0:05:00
#PBS -j oe
# Can a compute node read an environment's container? It times `import
# mlflow` in the container, as a job's start does; in the imaging/1 venv
# that took about 20 s (job 9571395). Exit 124 means it hung past 120 s, so
# stop submitting and tell Patrick (docs/agents/katana-test-run.md).
#
#   qsub -m abe -v CLONE=<clone>,PYTHONUNBUFFERED=1 canary.pbs
#
# CLONE is the clone whose lib/katana.sh names the environments folder and
# the researcher tools' version: the system clone, or a test folder's copy,
# T/iris. Add VERSION=<env>/<n> to -v for the version a form pins instead.
: "${CLONE:?pass CLONE=<clone> with qsub -v}"
. "$CLONE/lib/katana.sh" || exit 1
sif="$IRIS_ENVS_FOLDER/${VERSION:-$IRIS_TOOLS_ENV_VERSION}.sif"
[ -f "$sif" ] || { echo "no container file at $sif"; exit 1; }
echo "host $(hostname) $(date +%T) $sif"
time timeout 120 apptainer exec --cleanenv "$sif" python -X faulthandler -c 'import mlflow; print("mlflow", mlflow.__version__)'
echo "exit $? $(date +%T)"

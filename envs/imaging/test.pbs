#!/bin/bash
#PBS -N iris-env-imaging-test
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:20:00
#PBS -j oe

# Step 4 of a build, alongside the smoke tests: run the shared library's
# tests, then each workflow's, on CPU against the real environment. On
# Katana this includes the lib/iris-job.sh tests the desktop skips.
#
# Submit from this folder in a clone on Katana:
#   qsub -v VERSION=<n> test.pbs
# The Python module is the clone's lib/katana.sh's; for a version built on
# another, add PYTHON_MODULE=<module> to -v, as for every build step.

set -eo pipefail

: "${VERSION:?submit with qsub -v VERSION=<n> test.pbs}"
RECIPE="${PBS_O_WORKDIR:?submit with qsub from envs/imaging}"
. "$RECIPE/../../lib/katana.sh"
ENV_DIR="${IRIS_ENV_DIR%/*}/$VERSION"

. /etc/profile.d/modules.sh
module load "${PYTHON_MODULE:-$IRIS_PYTHON_MODULE}"

cd "$RECIPE/../.."
echo "Commit      : $(git rev-parse HEAD)"
echo "Environment : $ENV_DIR"
s=0
for dir in lib/tests workflows/*/tests; do
    ls "$dir"/test_*.py > /dev/null 2>&1 || continue
    echo "== $dir"
    "$ENV_DIR/bin/python" -m unittest discover -v -s "$dir" || s=1
done
exit $s

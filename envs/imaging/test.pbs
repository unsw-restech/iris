#!/bin/bash
#PBS -N iris-env-imaging-test
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:20:00
#PBS -j oe

# Step 4 of a build, alongside the smoke tests: run the reference workflow's
# tests on CPU against the real environment. On Katana this includes the
# lib/iris-job.sh tests the desktop skips.
#
# Submit from this folder in a clone on Katana:
#   qsub -v VERSION=<n> test.pbs

set -eo pipefail

: "${VERSION:?submit with qsub -v VERSION=<n> test.pbs}"
RECIPE="${PBS_O_WORKDIR:?submit with qsub from envs/imaging}"
ENV_DIR="/srv/scratch/katana_ai/iris/envs/imaging/$VERSION"

. /etc/profile.d/modules.sh
module load python/3.13.2

cd "$RECIPE/../.."
echo "Commit      : $(git rev-parse HEAD)"
echo "Environment : $ENV_DIR"
"$ENV_DIR/bin/python" -m unittest discover -v -s workflows/microct-2d-segmentation/tests

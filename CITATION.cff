# GitHub turns this into the repo's "Cite this repository" button;
# README.md's "Citing IRIS" is the full instruction.
cff-version: 1.2.0
message: >-
  If you publish results from an IRIS run, cite the workflow's citable
  version or IRIS as below, give the commit in the run's commit.txt, and
  acknowledge Katana. README.md's "Citing IRIS" says which to cite:
  https://github.com/unsw-restech/iris#citing-iris
title: "IRIS: Intelligent Research Imaging Suite, the UNSW ResTech AI Imaging Gateway"
type: software
authors:
  - name: UNSW Research Technology Services
url: "https://docs.restech.unsw.edu.au/iris/"
repository-code: "https://github.com/unsw-restech/iris"
license: Apache-2.0
identifiers:
  - type: url
    value: "https://workflowhub.eu/projects/472"
    description: UNSW ResTech's project on WorkflowHub
  # One DOI per citable version, newest first within each workflow.
  # GitHub's button reads only a top-level doi, so these never stand in for IRIS's.
  - type: doi
    value: 10.48546/workflowhub.workflow.2359.1
    description: "microct-2d-segmentation's citable version of 2026-10-26, commit 23e9314"
references:
  # Katana's DataCite record for its DOI, as published.
  - type: generic
    title: Katana
    authors:
      - name: "PVC (Research Infrastructure), UNSW Sydney"
    publisher:
      name: "UNSW, Sydney"
    year: 2010
    doi: 10.26190/669x-a286
    url: "https://researchdata.edu.au/katana/1733007"

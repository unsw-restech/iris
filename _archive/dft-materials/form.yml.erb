---
form:

  job_name:
    widget: text
    label: "PBS Job name"
    value: "iris_dft_materials"
    help: "No spaces or special characters."

  input_file:
    widget: path
    label: "Quantum ESPRESSO input (optional)"
    show_files: true
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Leave empty to run the bundled bulk silicon example. Put your own pseudopotentials in run/pseudo/."

  # ── Resources ───────────────────────────────────────
  ncpus:
    widget: number
    label: "CPU cores (1 - 16)"
    value: 8
    min: 1
    max: 16
    step: 1
    help: "Jobs requesting up to 16 CPUs can run on any Katana node."

  mem:
    widget: select
    label: "Memory"
    value: "16gb"
    options:
      - [ "8 GB",   "8gb"   ]
      - [ "16 GB",  "16gb"  ]
      - [ "32 GB",  "32gb"  ]
      - [ "64 GB",  "64gb"  ]
      - [ "124 GB", "124gb" ]
    help: "Up to 124gb available on any node."

  time:
    widget: number
    label:   [ "Walltime hours (0 - 200)", "Walltime minutes (0 - 59)" ]
    size:    2
    value:   [ 1, 0 ]
    min:     [ 0, 0 ]
    max:     [ 200, 59 ]
    step:    [ 1, 1 ]
    help: "Maximum 200 hours on Katana. Jobs <= 12hrs can run on any node."

  # ── Advanced options ─────────────────────────────────────
  show_advanced_option:
    widget: checkbox
    options:
      - [ "Show advanced options", "", show-mail_events, show-log, show-logname, show-module ]

  mail_events:
    label: "Mail events"
    widget: checkbox
    direction: horizontal
    separator: ""
    indent: 1
    options:
      - [ "Send email when a job ends abnormally", "a" ]
      - [ "Send email when a job starts",          "b" ]
      - [ "Send email when a job ends",            "e" ]

  log:
    widget: checkbox
    indent: 1
    options:
      - [ "Merge stderr into stdout (-j oe)", "oe", disable-logname ]

  logname:
    widget: text
    indent: 1
    label:  [ "File name of stdout", "File name of stderr" ]
    size:   2

  module:
    widget: multi_select
    label: "Additional modules"
    indent: 1
    separator: " "
    help: "The main module is loaded for you. Add others only if your own post-processing needs them."
    options:
    <% require 'open3'
       stdout, _ = Open3.capture2e(
         {"MODULEPATH" => "/etc/scl/modulefiles:/apps/Modules/linux-rocky8-ivybridge:/apps/neurodesk/modules:/usr/share/Modules/modulefiles:/etc/modulefiles:/usr/share/modulefiles"},
         "/usr/share/Modules/libexec/modulecmd.tcl", "sh", "avail", "-t"
       )
       mods = stdout.split(/\s+/).reject { |m|
         m.empty? || m.end_with?(":") || m.start_with?("/")
       }.select { |m|
         m.match?(/quantum-espresso|cp2k|openmpi|intel/i)
       }.sort
       mods.each do |mod| %>
      - [ "<%= mod %>", "<%= mod %>" ]
    <% end %>

  # ── Output directory ──────────────────────────────────────
  working_dir:
    widget: path
    label: "Output directory"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Recommended: your scratch directory /srv/scratch/zID"

script: |
  #!/bin/bash
  #PBS -N #{job_name}
  #PBS -l select=1:ncpus=#{ncpus}:mem=#{mem}
  #PBS -l walltime=#{time_1}:#{zeropadding(time_2, 2)}:00
  #PBS -M <%= ENV['USER'] %>@ad.unsw.edu.au
  #PBS -m #{mail_events}
  #PBS -j #{log}
  #PBS -o #{logname_1}
  #PBS -e #{logname_2}

  set -eo pipefail

  OUTDIR="#{working_dir}"
  mkdir -p "$OUTDIR"

  echo "========================================"
  echo "  Materials DFT (Quantum ESPRESSO)"
  echo "========================================"
  echo "Timestamp : $(date)"
  echo "Job ID    : $PBS_JOBID"
  echo "Hostname  : $(hostname)"
  echo "Output    : $OUTDIR"
  echo ""

  # Module scripts reference unset variables, so keep nounset off here.
  module purge
  module load quantum-espresso/7.1 #{module}

  echo "Loaded modules:"
  module list 2>&1 | sed 's/^/  /'
  echo ""

  RAW="https://raw.githubusercontent.com/PatrickTung/iris/main/workflows/dft-materials"
  RUNDIR="$OUTDIR/run"; mkdir -p "$RUNDIR/pseudo" "$RUNDIR/out"; cd "$RUNDIR"
  if [ -n "#{input_file}" ]; then
    cp "#{input_file}" "$RUNDIR/"; IN=$(basename "#{input_file}")
  else
    IN="si_scf.in"
    [ -f "$IN" ] || curl -fsSL "$RAW/inputs/si_scf.in" -o "$IN"
    [ -f "pseudo/Si.pz-vbc.UPF" ] || curl -fsSL \
      "https://pseudopotentials.quantum-espresso.org/upf_files/Si.pz-vbc.UPF" \
      -o "pseudo/Si.pz-vbc.UPF"
  fi
  if command -v mpirun > /dev/null 2>&1 && [ "#{ncpus}" -gt 1 ]; then
    mpirun -np #{ncpus} pw.x -in "$IN" > "${IN%.*}.out" 2>&1 || true
  else
    pw.x -in "$IN" > "${IN%.*}.out" 2>&1 || true
  fi
  grep -q "JOB DONE" "${IN%.*}.out" || { tail -30 "${IN%.*}.out"; exit 1; }
  grep -E "^!" "${IN%.*}.out" | tail -1

  echo ""
  echo "Results in: $OUTDIR"
  echo "========================================"
  echo "  Complete"
  echo "========================================"

check: |
  if @time_1.to_i == 0 && @time_2.to_i == 0
    halt 500, "Walltime cannot be zero."
  end

  if @time_1.to_i > 200
    halt 500, "Maximum walltime on Katana is 200 hours."
  end

  if @working_dir.to_s.strip.empty?
    halt 500, "Choose an output directory - your scratch space is recommended."
  end

---
form:

  job_name:
    widget: text
    label: "PBS Job name"
    value: "iris_cellpose_segmentation"
    help: "No spaces or special characters."

  image_dir:
    widget: path
    label: "Image directory"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Directory of microscopy images (TIFF or PNG)."

  model:
    widget: select
    label: "Model"
    value: "cyto3"
    options:
      - [ "cyto3 - whole cells", "cyto3" ]
      - [ "cyto2", "cyto2" ]
      - [ "nuclei only", "nuclei" ]
    help: "Generalist models; no retraining needed."

  diameter:
    widget: number
    label: "Cell diameter in pixels (0 = estimate)"
    value: 0
    min: 0
    max: 500
    step: 1
    help: "Leave at 0 to let Cellpose estimate it."

  # ── Resources ───────────────────────────────────────
  ngpus:
    widget: number
    label: "GPUs (0 = CPU only)"
    value: 1
    min: 0
    max: 1
    step: 1
    help: "Strongly recommended for anything beyond a handful of images."

  ncpus:
    widget: number
    label: "CPU cores (1 - 16)"
    value: 8
    min: 1
    max: 16
    step: 1
    help: "Jobs requesting up to 16 CPUs can run on any Katana node."

  mem:
    widget: select
    label: "Memory"
    value: "32gb"
    options:
      - [ "16 GB",  "16gb"  ]
      - [ "32 GB",  "32gb"  ]
      - [ "64 GB",  "64gb"  ]
      - [ "124 GB", "124gb" ]
    help: "Up to 124gb available on any node."

  time:
    widget: number
    label:   [ "Walltime hours (0 - 200)", "Walltime minutes (0 - 59)" ]
    size:    2
    value:   [ 4, 0 ]
    min:     [ 0, 0 ]
    max:     [ 200, 59 ]
    step:    [ 1, 1 ]
    help: "Maximum 200 hours on Katana. Jobs <= 12hrs can run on any node."

  # ── Advanced options ─────────────────────────────────────
  show_advanced_option:
    widget: checkbox
    options:
      - [ "Show advanced options", "", show-mail_events, show-log, show-logname, show-module ]

  mail_events:
    label: "Mail events"
    widget: checkbox
    direction: horizontal
    separator: ""
    indent: 1
    options:
      - [ "Send email when a job ends abnormally", "a" ]
      - [ "Send email when a job starts",          "b" ]
      - [ "Send email when a job ends",            "e" ]

  log:
    widget: checkbox
    indent: 1
    options:
      - [ "Merge stderr into stdout (-j oe)", "oe", disable-logname ]

  logname:
    widget: text
    indent: 1
    label:  [ "File name of stdout", "File name of stderr" ]
    size:   2

  module:
    widget: multi_select
    label: "Additional modules"
    indent: 1
    separator: " "
    help: "The main module is loaded for you. Add others only if your own post-processing needs them."
    options:
    <% require 'open3'
       stdout, _ = Open3.capture2e(
         {"MODULEPATH" => "/etc/scl/modulefiles:/apps/Modules/linux-rocky8-ivybridge:/apps/neurodesk/modules:/usr/share/Modules/modulefiles:/etc/modulefiles:/usr/share/modulefiles"},
         "/usr/share/Modules/libexec/modulecmd.tcl", "sh", "avail", "-t"
       )
       mods = stdout.split(/\s+/).reject { |m|
         m.empty? || m.end_with?(":") || m.start_with?("/")
       }.select { |m|
         m.match?(/python|cuda|cudnn/i)
       }.sort
       mods.each do |mod| %>
      - [ "<%= mod %>", "<%= mod %>" ]
    <% end %>

  # ── Output directory ──────────────────────────────────────
  working_dir:
    widget: path
    label: "Output directory"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Recommended: your scratch directory /srv/scratch/zID"

script: |
  #!/bin/bash
  #PBS -N #{job_name}
  #PBS -l select=1:ncpus=#{ncpus}:mem=#{mem}:ngpus=#{ngpus}
  #PBS -l walltime=#{time_1}:#{zeropadding(time_2, 2)}:00
  #PBS -M <%= ENV['USER'] %>@ad.unsw.edu.au
  #PBS -m #{mail_events}
  #PBS -j #{log}
  #PBS -o #{logname_1}
  #PBS -e #{logname_2}

  set -eo pipefail

  OUTDIR="#{working_dir}"
  mkdir -p "$OUTDIR"

  echo "========================================"
  echo "  Cell Segmentation (Cellpose)"
  echo "========================================"
  echo "Timestamp : $(date)"
  echo "Job ID    : $PBS_JOBID"
  echo "Hostname  : $(hostname)"
  echo "Output    : $OUTDIR"
  echo ""

  if [ "#{ngpus}" -gt 0 ] && command -v nvidia-smi > /dev/null 2>&1; then
    nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
  else
    echo "No GPU requested - running on CPU."
  fi
  echo ""

  # Module scripts reference unset variables, so keep nounset off here.
  module purge
  module load python/3.10.8 #{module}

  echo "Loaded modules:"
  module list 2>&1 | sed 's/^/  /'
  echo ""

  VENV="$OUTDIR/.venv"
  if [ ! -d "$VENV" ]; then
    echo "Creating virtual environment (first run only)"
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --upgrade pip
    "$VENV/bin/pip" install --quiet "cellpose==3.*"
  fi
  GPUFLAG=""; [ "#{ngpus}" -gt 0 ] && GPUFLAG="--use_gpu"
  DIAFLAG=""; [ "#{diameter}" != "0" ] && DIAFLAG="--diameter #{diameter}"
  "$VENV/bin/python" -m cellpose --dir "#{image_dir}" \
    --pretrained_model #{model} --chan 0 \
    --save_png --savedir "$OUTDIR" $DIAFLAG $GPUFLAG

  echo ""
  echo "Results in: $OUTDIR"
  echo "========================================"
  echo "  Complete"
  echo "========================================"

check: |
  if @time_1.to_i == 0 && @time_2.to_i == 0
    halt 500, "Walltime cannot be zero."
  end

  if @time_1.to_i > 200
    halt 500, "Maximum walltime on Katana is 200 hours."
  end

  if @working_dir.to_s.strip.empty?
    halt 500, "Choose an output directory - your scratch space is recommended."
  end

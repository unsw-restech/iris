---
form:

  job_name:
    widget: text
    label: "PBS Job name"
    value: "iris_metagenomics_profiling"
    help: "No spaces or special characters."

  reads_dir:
    widget: path
    label: "Reads directory"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Paired-end FASTQ named *_R1*.fastq.gz / *_R2*.fastq.gz."

  kraken_db:
    widget: path
    label: "Kraken2 database"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Path to a Kraken2 database directory."

  confidence:
    widget: number
    label: "Confidence threshold"
    value: 0.1
    min: 0
    max: 1
    step: 0.05
    help: "Raise it to reduce false positives."

  # ── Resources ───────────────────────────────────────
  ncpus:
    widget: number
    label: "CPU cores (1 - 16)"
    value: 16
    min: 1
    max: 16
    step: 1
    help: "Jobs requesting up to 16 CPUs can run on any Katana node."

  mem:
    widget: select
    label: "Memory"
    value: "64gb"
    options:
      - [ "32 GB",  "32gb"  ]
      - [ "64 GB",  "64gb"  ]
      - [ "124 GB", "124gb" ]
      - [ "248 GB", "248gb" ]
    help: "The standard Kraken2 database needs about 50 GB resident."

  time:
    widget: number
    label:   [ "Walltime hours (0 - 200)", "Walltime minutes (0 - 59)" ]
    size:    2
    value:   [ 12, 0 ]
    min:     [ 0, 0 ]
    max:     [ 200, 59 ]
    step:    [ 1, 1 ]
    help: "Maximum 200 hours on Katana. Jobs <= 12hrs can run on any node."

  # ── Advanced options ─────────────────────────────────────
  show_advanced_option:
    widget: checkbox
    options:
      - [ "Show advanced options", "", show-mail_events, show-log, show-logname, show-module ]

  mail_events:
    label: "Mail events"
    widget: checkbox
    direction: horizontal
    separator: ""
    indent: 1
    options:
      - [ "Send email when a job ends abnormally", "a" ]
      - [ "Send email when a job starts",          "b" ]
      - [ "Send email when a job ends",            "e" ]

  log:
    widget: checkbox
    indent: 1
    options:
      - [ "Merge stderr into stdout (-j oe)", "oe", disable-logname ]

  logname:
    widget: text
    indent: 1
    label:  [ "File name of stdout", "File name of stderr" ]
    size:   2

  module:
    widget: multi_select
    label: "Additional modules"
    indent: 1
    separator: " "
    help: "The main module is loaded for you. Add others only if your own post-processing needs them."
    options:
    <% require 'open3'
       stdout, _ = Open3.capture2e(
         {"MODULEPATH" => "/etc/scl/modulefiles:/apps/Modules/linux-rocky8-ivybridge:/apps/neurodesk/modules:/usr/share/Modules/modulefiles:/etc/modulefiles:/usr/share/modulefiles"},
         "/usr/share/Modules/libexec/modulecmd.tcl", "sh", "avail", "-t"
       )
       mods = stdout.split(/\s+/).reject { |m|
         m.empty? || m.end_with?(":") || m.start_with?("/")
       }.select { |m|
         m.match?(/kraken|metaphlan|humann|python/i)
       }.sort
       mods.each do |mod| %>
      - [ "<%= mod %>", "<%= mod %>" ]
    <% end %>

  # ── Output directory ──────────────────────────────────────
  working_dir:
    widget: path
    label: "Output directory"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Recommended: your scratch directory /srv/scratch/zID"

script: |
  #!/bin/bash
  #PBS -N #{job_name}
  #PBS -l select=1:ncpus=#{ncpus}:mem=#{mem}
  #PBS -l walltime=#{time_1}:#{zeropadding(time_2, 2)}:00
  #PBS -M <%= ENV['USER'] %>@ad.unsw.edu.au
  #PBS -m #{mail_events}
  #PBS -j #{log}
  #PBS -o #{logname_1}
  #PBS -e #{logname_2}

  set -eo pipefail

  OUTDIR="#{working_dir}"
  mkdir -p "$OUTDIR"

  echo "========================================"
  echo "  Metagenomics Profiling"
  echo "========================================"
  echo "Timestamp : $(date)"
  echo "Job ID    : $PBS_JOBID"
  echo "Hostname  : $(hostname)"
  echo "Output    : $OUTDIR"
  echo ""

  # Module scripts reference unset variables, so keep nounset off here.
  module purge
  module load kraken2/2.1.2 #{module}

  echo "Loaded modules:"
  module list 2>&1 | sed 's/^/  /'
  echo ""

  for R1 in "#{reads_dir}"/*_R1*.fastq.gz; do
    [ -e "$R1" ] || { echo "No *_R1*.fastq.gz in #{reads_dir}"; exit 1; }
    S=$(basename "$R1" | sed "s/_R1.*//")
    R2="${R1/_R1/_R2}"
    echo "Classifying $S"
    kraken2 --db "#{kraken_db}" --threads #{ncpus} \
      --confidence #{confidence} --paired "$R1" "$R2" \
      --report "$OUTDIR/${S}_report.txt" \
      --output "$OUTDIR/${S}_kraken.out"
  done

  echo ""
  echo "Results in: $OUTDIR"
  echo "========================================"
  echo "  Complete"
  echo "========================================"

check: |
  if @time_1.to_i == 0 && @time_2.to_i == 0
    halt 500, "Walltime cannot be zero."
  end

  if @time_1.to_i > 200
    halt 500, "Maximum walltime on Katana is 200 hours."
  end

  if @working_dir.to_s.strip.empty?
    halt 500, "Choose an output directory - your scratch space is recommended."
  end

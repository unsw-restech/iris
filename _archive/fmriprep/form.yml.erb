---
form:

  job_name:
    widget: text
    label: "PBS Job name"
    value: "iris_fmriprep"
    help: "No spaces or special characters."

  bids_dir:
    widget: path
    label: "BIDS dataset"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Root of your BIDS-formatted dataset."

  participants:
    widget: text
    label: "Participant labels"
    value: ""
    help: "Space-separated labels without the sub- prefix. Leave empty to process everyone."

  output_spaces:
    widget: select
    label: "Output spaces"
    value: "MNI152NLin2009cAsym"
    options:
      - [ "MNI152NLin2009cAsym", "MNI152NLin2009cAsym" ]
      - [ "MNI152NLin2009cAsym + T1w", "MNI152NLin2009cAsym T1w" ]
      - [ "T1w only", "T1w" ]
    help: "Template spaces to resample into."

  fs_license:
    widget: path
    label: "FreeSurfer licence"
    show_files: true
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "fMRIPrep requires a FreeSurfer licence file."

  # ── Resources ───────────────────────────────────────
  ncpus:
    widget: number
    label: "CPU cores (1 - 16)"
    value: 16
    min: 1
    max: 16
    step: 1
    help: "Jobs requesting up to 16 CPUs can run on any Katana node."

  mem:
    widget: select
    label: "Memory"
    value: "64gb"
    options:
      - [ "32 GB",  "32gb"  ]
      - [ "64 GB",  "64gb"  ]
      - [ "124 GB", "124gb" ]
      - [ "248 GB", "248gb" ]
    help: "fMRIPrep needs real headroom per subject."

  time:
    widget: number
    label:   [ "Walltime hours (0 - 200)", "Walltime minutes (0 - 59)" ]
    size:    2
    value:   [ 48, 0 ]
    min:     [ 0, 0 ]
    max:     [ 200, 59 ]
    step:    [ 1, 1 ]
    help: "Maximum 200 hours on Katana. Jobs <= 12hrs can run on any node."

  # ── Advanced options ─────────────────────────────────────
  show_advanced_option:
    widget: checkbox
    options:
      - [ "Show advanced options", "", show-mail_events, show-log, show-logname, show-module ]

  mail_events:
    label: "Mail events"
    widget: checkbox
    direction: horizontal
    separator: ""
    indent: 1
    options:
      - [ "Send email when a job ends abnormally", "a" ]
      - [ "Send email when a job starts",          "b" ]
      - [ "Send email when a job ends",            "e" ]

  log:
    widget: checkbox
    indent: 1
    options:
      - [ "Merge stderr into stdout (-j oe)", "oe", disable-logname ]

  logname:
    widget: text
    indent: 1
    label:  [ "File name of stdout", "File name of stderr" ]
    size:   2

  module:
    widget: multi_select
    label: "Additional modules"
    indent: 1
    separator: " "
    help: "The main module is loaded for you. Add others only if your own post-processing needs them."
    options:
    <% require 'open3'
       stdout, _ = Open3.capture2e(
         {"MODULEPATH" => "/etc/scl/modulefiles:/apps/Modules/linux-rocky8-ivybridge:/apps/neurodesk/modules:/usr/share/Modules/modulefiles:/etc/modulefiles:/usr/share/modulefiles"},
         "/usr/share/Modules/libexec/modulecmd.tcl", "sh", "avail", "-t"
       )
       mods = stdout.split(/\s+/).reject { |m|
         m.empty? || m.end_with?(":") || m.start_with?("/")
       }.select { |m|
         m.match?(/neurodesk|fsl|freesurfer|python/i)
       }.sort
       mods.each do |mod| %>
      - [ "<%= mod %>", "<%= mod %>" ]
    <% end %>

  # ── Output directory ──────────────────────────────────────
  working_dir:
    widget: path
    label: "Output directory"
    show_files: false
    favorites:
      - /srv/scratch/<%= ENV['USER'] %>
    help: "Recommended: your scratch directory /srv/scratch/zID"

script: |
  #!/bin/bash
  #PBS -N #{job_name}
  #PBS -l select=1:ncpus=#{ncpus}:mem=#{mem}
  #PBS -l walltime=#{time_1}:#{zeropadding(time_2, 2)}:00
  #PBS -M <%= ENV['USER'] %>@ad.unsw.edu.au
  #PBS -m #{mail_events}
  #PBS -j #{log}
  #PBS -o #{logname_1}
  #PBS -e #{logname_2}

  set -eo pipefail

  OUTDIR="#{working_dir}"
  mkdir -p "$OUTDIR"

  echo "========================================"
  echo "  fMRI Preprocessing (fMRIPrep)"
  echo "========================================"
  echo "Timestamp : $(date)"
  echo "Job ID    : $PBS_JOBID"
  echo "Hostname  : $(hostname)"
  echo "Output    : $OUTDIR"
  echo ""

  # Module scripts reference unset variables, so keep nounset off here.
  module purge
  module load neurodesk/fmriprep/23.0.0 #{module}

  echo "Loaded modules:"
  module list 2>&1 | sed 's/^/  /'
  echo ""

  export FS_LICENSE="#{fs_license}"
  MEMMB=$(( $(echo "#{mem}" | tr -d "gb") * 1000 ))
  PL=""; [ -n "#{participants}" ] && PL="--participant-label #{participants}"
  fmriprep "#{bids_dir}" "$OUTDIR" participant $PL \
    --output-spaces #{output_spaces} \
    --nprocs #{ncpus} --mem-mb $MEMMB \
    -w "$OUTDIR/work"

  echo ""
  echo "Results in: $OUTDIR"
  echo "========================================"
  echo "  Complete"
  echo "========================================"

check: |
  if @time_1.to_i == 0 && @time_2.to_i == 0
    halt 500, "Walltime cannot be zero."
  end

  if @time_1.to_i > 200
    halt 500, "Maximum walltime on Katana is 200 hours."
  end

  if @working_dir.to_s.strip.empty?
    halt 500, "Choose an output directory - your scratch space is recommended."
  end

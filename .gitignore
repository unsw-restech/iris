# Python bytecode — regenerated whenever lib/ or workflows/*/src/*.py is
# run or byte-compiled from a checkout, so this reappears constantly
# without an ignore.
__pycache__/
*.py[cod]

# Run outputs, if anyone points a run at a checkout instead of scratch.
# The defaults write outside the repo, but this is cheap insurance against
# committing a model.pt.
*.pt
metrics.json
# except the frozen sample run directories the shared tools' tests read
!lib/tests/samples/**/metrics.json

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Claude Code's settings and agent worktrees, written into a clone by a
# session; untracked, so bin/check's untracked-file check would report them.
.claude/

# A working plan (AGENTS.md), deleted when its work is done and never
# committed; ignored so bin/check's untracked-file check passes beside it.
plan.md
